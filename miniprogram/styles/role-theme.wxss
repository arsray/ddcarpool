/**
 * 双身份视觉规范：车主蓝（区别于主题色）/ 乘客紫红
 */
page {
  --role-owner: #2563EB;
  --role-owner-bg: #EFF6FF;
  --role-owner-soft: #F5F9FF;
  --role-passenger: #7B4B94;
  --role-passenger-bg: #F3EBF7;
  --role-passenger-soft: #FAF5FC;
}

.v1-role-seg {
  display: flex;
  height: 68rpx;
  padding: 4rpx;
  margin-bottom: 16rpx;
  background: #EEF1F6;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.v1-role-seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.2;
}

.v1-role-seg-item.on.owner {
  background: var(--role-owner);
  color: #FFFFFF;
  font-weight: 600;
}

.v1-role-seg-item.on.passenger {
  background: var(--role-passenger);
  color: #FFFFFF;
  font-weight: 600;
}

.v1-role-seg-item:active {
  opacity: 0.88;
}

.v1-role-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.v1-role-chip--owner {
  background: var(--role-owner-bg);
  color: var(--role-owner);
}

.v1-role-chip--passenger {
  background: var(--role-passenger-bg);
  color: var(--role-passenger);
}

.v1-role-title--owner {
  color: var(--role-owner);
}

.v1-role-title--passenger {
  color: var(--role-passenger);
}

.v1-role-accent-bar--owner {
  border-left: 6rpx solid var(--role-owner);
  padding-left: 12rpx;
}

.v1-role-accent-bar--passenger {
  border-left: 6rpx solid var(--role-passenger);
  padding-left: 12rpx;
}

.v1-page-head .v1-page-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.4;
}
