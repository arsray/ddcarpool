.container {
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.identity-switch {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.identity-single {
  margin-bottom: 16rpx;
}

.identity-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.identity-single .identity-chip {
  max-width: 360rpx;
}

.identity-chip--owner {
  background: var(--role-owner-bg);
  color: var(--role-owner);
}

.identity-chip--passenger {
  background: var(--role-passenger-bg);
  color: var(--role-passenger);
}

.identity-chip--owner.is-active {
  background: var(--role-owner);
  color: #FFFFFF;
  border-color: var(--role-owner);
}

.identity-chip--passenger.is-active {
  background: var(--role-passenger);
  color: #FFFFFF;
  border-color: var(--role-passenger);
}

.identity-chip.is-tappable:active {
  opacity: 0.85;
}

.identity-chip-label {
  font-size: 30rpx;
  font-weight: 600;
}

.identity-chip-hint {
  font-size: 22rpx;
  font-weight: 500;
  opacity: 0.9;
}

.identity-chip-action {
  font-size: 22rpx;
  font-weight: 500;
  opacity: 0.72;
}

.tip {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.add-btn {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.add-btn.owner {
  background: var(--role-owner-bg);
  color: var(--role-owner);
}

.add-btn.passenger {
  background: var(--role-passenger-bg);
  color: var(--role-passenger);
}

.add-btn::after {
  border: none;
}
