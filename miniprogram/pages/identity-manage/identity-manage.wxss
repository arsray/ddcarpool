.identity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.identity-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.active-tag {
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.tip {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 24rpx;
}

.add-btn {
  width: 100%;
  margin-top: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.add-btn.owner {
  background: #eff6ff;
  color: #2563eb;
}

.add-btn.passenger {
  background: #ecfdf5;
  color: #059669;
}

.add-btn::after {
  border: none;
}
