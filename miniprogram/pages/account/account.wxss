@import '../mine/m1-shared.wxss';

.field-card { padding: 0; overflow: hidden; }
.field-row { display:flex; justify-content:space-between; padding:28rpx; border-bottom:1rpx solid #f1f5f9; }
.field-row:last-child { border-bottom:none; }
.label { color:#64748b; font-size:26rpx; }
.value { font-size:28rpx; }
.muted { color:#94a3b8; }
.mock-section {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 48, 135, 0.06);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}
.section-desc {
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}
.mock-user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #f1f5f9;
}
.mock-user-row:first-of-type {
  border-top: none;
}
.mock-user-row.active {
  background: #f8fbff;
  margin: 0 -28rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}
.mock-user-label {
  font-size: 28rpx;
  font-weight: 500;
}
.mock-user-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}
.mock-user-email {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #94a3b8;
}
.mock-user-check {
  font-size: 22rpx;
  color: #2563eb;
  flex-shrink: 0;
}
.logout-btn { margin-top:40rpx; background:#64748b; color:#fff; border-radius:12rpx; }
.logout-btn::after { border:none; }