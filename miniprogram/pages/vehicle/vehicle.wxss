/* ===== DDCarpool V1 — 车辆信息 / Onboarding ===== */

.v1-onboard-page.container {
  padding: 24rpx 32rpx 48rpx;
  background: #F5F7FA;
  box-sizing: border-box;
}

.v1-head {
  margin-bottom: 20rpx;
}

.v1-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.3;
}

.v1-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.45;
}

.v1-form-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-field {
  margin-bottom: 24rpx;
}

.v1-field--last {
  margin-bottom: 0;
}

.v1-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
}

.v1-picker,
.v1-input {
  height: 80rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.v1-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}

.v1-picker-value {
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.4;
}

.v1-placeholder {
  font-size: 26rpx;
  color: #98A2B3;
}

.v1-chevron {
  color: #C4CBD4;
  font-size: 32rpx;
  line-height: 1;
}

.v1-input {
  width: 100%;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 80rpx;
}

.v1-radio-group {
  display: flex;
  gap: 32rpx;
  min-height: 80rpx;
  align-items: center;
}

.v1-radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #1F2937;
}

.v1-plate-row {
  display: flex;
  gap: 12rpx;
}

.v1-plate-prefix {
  flex-shrink: 0;
  width: 112rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #EAF1FB;
  color: #003087;
  border: 1rpx solid #EAF1FB;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.v1-plate-suffix {
  flex: 1;
  min-width: 0;
}

.v1-field-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #98A2B3;
  line-height: 1.4;
}

.v1-chips,
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.v1-chip {
  padding: 8rpx 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7ECF2;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  box-sizing: border-box;
}

.v1-chip.on {
  background: #EAF1FB;
  border-color: #003087;
  color: #003087;
}

.v1-chip.on-light {
  background: #F8FAFC;
  border-color: #E7ECF2;
  color: #1F2937;
}

.v1-color-custom {
  margin-top: 12rpx;
}

.v1-cta {
  display: block;
  width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0;
  line-height: 80rpx;
  background: #003087;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.v1-cta::after {
  border: none;
}

.v1-skip {
  display: block;
  width: 100%;
  height: 72rpx;
  margin: 8rpx 0 0;
  padding: 0;
  line-height: 72rpx;
  background: transparent;
  color: #667085;
  font-size: 26rpx;
  font-weight: 400;
}

.v1-skip::after {
  border: none;
}

/* Pickers */
.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 41, 55, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  max-height: 75vh;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}

.panel-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.panel-close {
  padding: 0 8rpx;
  font-size: 40rpx;
  color: #98A2B3;
}

.common-row {
  margin-bottom: 16rpx;
}

.common-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #667085;
}

.index-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.index-item {
  padding: 4rpx 10rpx;
  font-size: 22rpx;
  color: #003087;
}

.brand-scroll,
.prefix-scroll {
  max-height: 48vh;
}

.prefix-chip {
  min-width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.prefix-char {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.group-letter {
  padding: 12rpx 0 8rpx;
  font-size: 22rpx;
  color: #98A2B3;
}

.brand-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EDF0F4;
  font-size: 28rpx;
  color: #1F2937;
}
