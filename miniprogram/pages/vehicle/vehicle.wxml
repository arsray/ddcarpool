<view class="v1-onboard-page container">
  <view class="v1-head">
    <view class="v1-title">{{onboarding || setup ? '录入你的车辆' : '车辆信息'}}</view>
    <view class="v1-sub">{{onboarding || setup ? '完善车辆信息，方便乘客识别' : '可随时修改，将用于后续发车'}}</view>
  </view>

  <view class="v1-form-card">
    <view class="v1-field">
      <text class="v1-label">品牌</text>
      <view class="v1-picker" bindtap="openBrandPicker">
        <text class="{{form.brand ? 'v1-picker-value' : 'v1-placeholder'}}">{{form.brand || '请选择品牌'}}</text>
        <text class="v1-chevron">›</text>
      </view>
    </view>

    <view class="v1-field">
      <text class="v1-label">车型</text>
      <radio-group class="v1-radio-group" bindchange="onModelChange">
        <label class="v1-radio-item"><radio value="SUV" checked="{{form.modelType==='SUV'}}" color="#003087" />SUV</label>
        <label class="v1-radio-item"><radio value="轿车" checked="{{form.modelType==='轿车'}}" color="#003087" />轿车</label>
      </radio-group>
    </view>

    <view class="v1-field">
      <text class="v1-label">车牌号</text>
      <view class="v1-plate-row">
        <view class="v1-plate-prefix" bindtap="openPrefixPicker">{{form.platePrefix || '地区'}}</view>
        <input
          class="v1-input v1-plate-suffix"
          value="{{form.plateSuffix}}"
          bindinput="onPlateSuffixInput"
          placeholder="如 A12345 或 D123456"
          maxlength="7"
        />
      </view>
      <text class="v1-field-hint">首位为车牌登记地区；支持普通与新能源车牌</text>
    </view>

    <view class="v1-field">
      <text class="v1-label">可载乘客数（不含司机）</text>
      <picker mode="selector" range="{{capacityRange}}" value="{{capacityIndex}}" bindchange="onCapacityChange">
        <view class="v1-picker">
          <text class="v1-picker-value">{{form.passengerCapacity}}</text>
          <text class="v1-chevron">›</text>
        </view>
      </picker>
    </view>

    <view class="v1-field v1-field--last">
      <text class="v1-label">颜色</text>
      <view class="v1-chips">
        <view
          wx:for="{{colorOptions}}"
          wx:key="*this"
          class="v1-chip {{form.color === item && !colorCustom ? 'on' : ''}}"
          data-color="{{item}}"
          bindtap="onColorSelect"
        >{{item}}</view>
      </view>
      <input
        wx:if="{{colorCustom}}"
        class="v1-input v1-color-custom"
        value="{{form.colorCustom}}"
        bindinput="onColorCustomInput"
        placeholder="请输入其他颜色"
      />
    </view>
  </view>

  <button class="v1-cta" bindtap="onSave">保存</button>
  <button wx:if="{{onboarding || setup}}" class="v1-skip" bindtap="onSkip">稍后再填</button>

  <view class="picker-mask" wx:if="{{showBrandPicker}}" bindtap="closeBrandPicker">
    <view class="picker-panel" catchtap="noop">
      <view class="panel-hd">
        <text class="panel-title">选择品牌</text>
        <text class="panel-close" bindtap="closeBrandPicker">×</text>
      </view>
      <view class="common-row">
        <text class="common-label">常用</text>
        <view class="chip-row">
          <view wx:for="{{commonBrands}}" wx:key="*this" class="v1-chip on-light" data-brand="{{item}}" bindtap="selectBrand">{{item}}</view>
        </view>
      </view>
      <view class="index-bar">
        <text wx:for="{{indexLetters}}" wx:key="*this" class="index-item" data-letter="{{item}}" bindtap="scrollToLetter">{{item}}</text>
      </view>
      <scroll-view scroll-y class="brand-scroll" scroll-into-view="{{brandScrollInto}}">
        <view wx:for="{{brandGroups}}" wx:key="letter" id="brand-{{item.letter}}" class="brand-group">
          <view class="group-letter">{{item.letter}}</view>
          <view wx:for="{{item.brands}}" wx:for-item="brand" wx:key="*this" class="brand-item" data-brand="{{brand}}" bindtap="selectBrand">{{brand}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="picker-mask" wx:if="{{showPrefixPicker}}" bindtap="closePrefixPicker">
    <view class="picker-panel" catchtap="noop">
      <view class="panel-hd">
        <text class="panel-title">选择地区</text>
        <text class="panel-close" bindtap="closePrefixPicker">×</text>
      </view>
      <view class="common-row">
        <text class="common-label">常用</text>
        <view class="chip-row">
          <view wx:for="{{commonPrefixes}}" wx:key="*this" class="v1-chip on-light prefix-chip" data-abbr="{{item}}" bindtap="selectPrefix">{{item}}</view>
        </view>
      </view>
      <scroll-view scroll-y class="prefix-scroll">
        <view wx:for="{{prefixGroups}}" wx:key="letter" class="brand-group">
          <view class="group-letter">{{item.letter}}</view>
          <view wx:for="{{item.items}}" wx:for-item="pref" wx:key="*this" class="brand-item prefix-char" data-abbr="{{pref}}" bindtap="selectPrefix">{{pref}}</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
