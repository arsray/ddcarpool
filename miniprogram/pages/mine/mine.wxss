/* ===== DDCarpool V1 — 我的 ===== */

.v1-mine-page.container.tab-page {
  padding: 16rpx 28rpx var(--space-md, 24rpx);
  background: #F5F7FA;
  box-sizing: border-box;
}

/* Profile */
.v1-profile {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-profile-avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #003087;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.v1-profile-main {
  flex: 1;
  min-width: 0;
}

.v1-profile-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-profile-ids {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-profile-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  max-width: 42%;
  margin-left: 12rpx;
  padding: 12rpx 0 12rpx 8rpx;
  min-height: 64rpx;
  box-sizing: border-box;
}

.v1-profile-action-text {
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-profile-action:active {
  opacity: 0.7;
}

/* Sections */
.v1-section {
  margin-top: 24rpx;
}

.v1-section-title {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.35;
}

/* Row cards */
.v1-row-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.v1-row-card--inline {
  min-height: 88rpx;
}

.v1-row-card:active,
.v1-group-row:active {
  opacity: 0.92;
}

.v1-row-main {
  flex: 1;
  min-width: 0;
}

.v1-row-primary {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-row-primary.is-muted {
  font-weight: 500;
  color: #667085;
}

.v1-row-secondary {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-row-meta {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #003087;
  line-height: 1.3;
  max-width: 40%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-chevron {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 32rpx;
  font-weight: 400;
  color: #C4CBD4;
  line-height: 1;
}

/* Settings group */
.v1-group-card {
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 20rpx;
  overflow: hidden;
}

.v1-group-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.v1-group-divider {
  height: 1rpx;
  margin: 0 24rpx;
  background: #EDF0F4;
}
