.agreement-page {
  padding: 32rpx 28rpx 64rpx;
  background: #F5F7FA;
  box-sizing: border-box;
}

.agreement-head {
  margin-bottom: 24rpx;
}

.agreement-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
}

.agreement-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #98A2B3;
}

.agreement-intro {
  margin-bottom: 28rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.65;
}

.agreement-section {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}

.agreement-section-title {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #003087;
}

.agreement-paragraph {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #374151;
  line-height: 1.65;
}

.agreement-paragraph:last-child {
  margin-bottom: 0;
}

.agreement-foot {
  padding: 32rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #C4CBD4;
}
