/* ===== DDCarpool V1 — 我的订单 ===== */

.v1-history-page.container {
  padding: 16rpx 28rpx 48rpx;
  background: #F5F7FA;
  box-sizing: border-box;
}

/* Role segmented control */
.v1-seg {
  display: flex;
  height: 68rpx;
  padding: 4rpx;
  margin-bottom: 16rpx;
  background: #EEF1F6;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.v1-seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.2;
}

.v1-seg-item.on,
.v1-seg-item.on.owner,
.v1-seg-item.on.passenger {
  background: #EAF1FB;
  color: #003087;
  font-weight: 600;
}

.v1-seg-item:active {
  opacity: 0.85;
}

/* Status filter chips */
.v1-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.v1-filter-item {
  padding: 8rpx 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7ECF2;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.3;
  box-sizing: border-box;
}

.v1-filter-item.on {
  background: #EAF1FB;
  border-color: #EAF1FB;
  color: #003087;
  font-weight: 600;
}

/* Order card */
.v1-order-card {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx 20rpx 24rpx;
  margin-bottom: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.v1-order-card:active {
  opacity: 0.92;
}

.v1-order-main {
  flex: 1;
  min-width: 0;
}

.v1-order-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.v1-order-route {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-source {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  background: #F8FAFC;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.3;
}

.v1-order-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  min-width: 0;
}

.v1-status {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
}

.v1-status.status-pub {
  background: #FFF8E8;
  color: #C47D0A;
}

.v1-status.status-wait,
.v1-status.status-ing {
  background: #EAF1FB;
  color: #003087;
}

.v1-status.status-done {
  background: #EAF8F2;
  color: #22B573;
}

.v1-status.status-exp {
  background: #F5F7FA;
  color: #98A2B3;
}

.v1-schedule {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-order-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-chevron {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 32rpx;
  font-weight: 400;
  color: #C4CBD4;
  line-height: 1;
}

/* Empty */
.v1-empty {
  padding: 120rpx 32rpx;
  text-align: center;
}

.v1-empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
}

.v1-empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.4;
}
