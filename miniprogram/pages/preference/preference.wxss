.textarea { width:100%; min-height:160rpx; background:#f8fafc; border:1rpx solid #e2e8f0; border-radius:12rpx; padding:20rpx 24rpx; box-sizing:border-box; }
.hint { font-size:22rpx; color:#94a3b8; line-height:1.6; margin:8rpx 0 24rpx; }
.save-btn { margin-top: 16rpx; }
.skip-btn { margin-top: 20rpx; background: transparent; color: #64748b; font-size: 28rpx; }
.skip-btn::after { border: none; }

.field { margin-bottom: 28rpx; }
.label { display:block; font-size:24rpx; color:#64748b; margin-bottom:10rpx; }

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.picker-field .arrow { color: #cbd5e1; font-size: 32rpx; }

.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e2e8f0;
  color: #64748b;
  background: #fff;
}
.tag.on {
  background: #ede9fe;
  color: #6d28d9;
  border-color: #c4b5fd;
}
