/* ===== DDCarpool V1 — 乘车偏好 / Onboarding ===== */

.v1-onboard-page.container {
  padding: 24rpx 32rpx 48rpx;
  background: #F5F7FA;
  box-sizing: border-box;
}

.v1-head {
  margin-bottom: 20rpx;
}

.v1-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.3;
}

.v1-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.45;
}

.v1-form-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-field {
  margin-bottom: 24rpx;
}

.v1-field--last {
  margin-bottom: 0;
}

.v1-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
}

.v1-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 20rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.v1-picker-value {
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.4;
}

.v1-chevron {
  color: #C4CBD4;
  font-size: 32rpx;
  line-height: 1;
}

.v1-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.v1-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7ECF2;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  box-sizing: border-box;
}

.v1-tag.on {
  background: #EAF1FB;
  border-color: #003087;
  color: #003087;
}

.v1-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.5;
}

.v1-hint {
  margin: 0 0 24rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.55;
}

.v1-cta {
  display: block;
  width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0;
  line-height: 80rpx;
  background: #003087;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.v1-cta::after {
  border: none;
}

.v1-skip {
  display: block;
  width: 100%;
  height: 72rpx;
  margin: 8rpx 0 0;
  padding: 0;
  line-height: 72rpx;
  background: transparent;
  color: #667085;
  font-size: 26rpx;
  font-weight: 400;
}

.v1-skip::after {
  border: none;
}
