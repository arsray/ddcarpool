/* ===== DDCarpool V1 — 订单详情 ===== */

.v1-detail-page.container {
  padding: 16rpx 28rpx 48rpx;
  background: #F5F7FA;
  box-sizing: border-box;
}

.v1-empty {
  padding: 120rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #98A2B3;
}

/* Status */
.v1-status-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.v1-status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
}

.v1-status-badge--matching,
.v1-status-badge--pending_departure,
.v1-status-badge--in_progress {
  background: #EAF1FB;
  color: #003087;
}

.v1-status-badge--completed {
  background: #EAF8F2;
  color: #22B573;
}

.v1-status-badge--closed {
  background: #F5F7FA;
  color: #98A2B3;
}

.v1-role-tag {
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.35;
}

/* Trip card: time + route + count */
.v1-trip-card {
  padding: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-trip-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.v1-time-block {
  flex: 1;
  min-width: 0;
}

.v1-time {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-date {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-count {
  flex-shrink: 0;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #667085;
  line-height: 1.3;
}

/* Route — match owner page dots */
.v1-route {
  margin-top: 4rpx;
}

.v1-route-row {
  display: flex;
  align-items: flex-start;
  min-height: 40rpx;
}

.v1-route-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 10rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.v1-route-dot--start {
  background: #22B573;
}

.v1-route-dot--end {
  background: #FF6B4A;
}

.v1-route-connector {
  width: 2rpx;
  height: 20rpx;
  margin: 2rpx 0 2rpx 5rpx;
  background: #E3E7EC;
}

.v1-route-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.v1-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.45;
}

/* Sections */
.v1-section {
  margin-top: 24rpx;
}

.v1-section-title {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.35;
}

.v1-group-card,
.v1-note-card {
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.v1-note-card {
  padding: 20rpx 24rpx;
}

.v1-group-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.v1-group-label {
  flex-shrink: 0;
  width: 80rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.4;
}

.v1-group-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #1F2937;
  line-height: 1.4;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-group-divider {
  height: 1rpx;
  margin: 0 24rpx;
  background: #EDF0F4;
}

/* Tags — match owner plaza */
.v1-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.v1-tag {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 6rpx 12rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  box-sizing: border-box;
  word-break: break-all;
}

/* Actions */
.v1-actions {
  margin-top: 32rpx;
}

.v1-btn {
  display: block;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin: 12rpx 0 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.v1-btn::after {
  border: none;
}

.v1-btn[disabled] {
  opacity: 0.55;
}

.v1-btn--accent {
  background: #FF6B4A;
  color: #FFFFFF;
}

.v1-btn--primary {
  background: #003087;
  color: #FFFFFF;
}

.v1-btn--secondary {
  background: #FFFFFF;
  color: #1F2937;
  border: 1rpx solid #E7ECF2;
}

.v1-btn--danger {
  background: #FFFFFF;
  color: #C4473A;
  border: 1rpx solid #F0D4D0;
  font-weight: 500;
}
