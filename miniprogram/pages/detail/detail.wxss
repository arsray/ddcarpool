/* ===== DDCarpool V1 — 订单详情 ===== */

.v1-detail-page.container {
  padding: 0 0 48rpx;
  background: #F5F7FA;
  box-sizing: border-box;
}

.v1-empty {
  padding: 120rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #98A2B3;
}

/* Status header */
.v1-status-header {
  position: relative;
  margin: 0 0 20rpx;
  padding: 32rpx 220rpx 36rpx 28rpx;
  min-height: 168rpx;
  box-sizing: border-box;
  overflow: visible;
}

.v1-status-header__watermark {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  bottom: 12rpx;
  width: 196rpx;
  height: calc(100% - 24rpx);
  min-height: 132rpx;
  max-height: 200rpx;
  opacity: 0.11;
  pointer-events: none;
  z-index: 0;
}

.v1-status-header__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.v1-status-header__role {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 0.5rpx;
}

.v1-status-header__status {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.v1-status-header__hint {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
  opacity: 0.88;
}

.v1-status-header--matching {
  background: linear-gradient(160deg, #EAF1FB 0%, #F5F8FC 100%);
  color: #003087;
}

.v1-status-header--pending_departure,
.v1-status-header--in_progress,
.v1-status-header--completed {
  background: linear-gradient(160deg, #EAF8F2 0%, #F5FBF8 100%);
  color: #1B7F52;
}

.v1-status-header--closed {
  background: linear-gradient(160deg, #EEF1F5 0%, #F5F7FA 100%);
  color: #667085;
}

/* Driver card — passenger view */
.v1-driver-card {
  margin: 0 28rpx 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.v1-driver-card__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #98A2B3;
  letter-spacing: 0.5rpx;
}

.v1-driver-card__body {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.v1-driver-card__icon {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #EAF1FB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
}

.v1-driver-card__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.v1-driver-card__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #101828;
  line-height: 1.3;
}

.v1-driver-card__vehicle {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.v1-driver-card__vehicle-item {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #F5F7FA;
  font-size: 22rpx;
  color: #344054;
  line-height: 1.3;
}

.v1-driver-card__vehicle-item--muted {
  color: #98A2B3;
  background: #F8FAFC;
}

/* Trip card */
.v1-trip-card {
  margin: 0 28rpx;
  padding: 28rpx 24rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-info-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.v1-info-row--route {
  align-items: flex-start;
}

.v1-info-row--note {
  align-items: flex-start;
}

.v1-info-row--last {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.v1-info-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
}

.v1-info-icon--time {
  background: #EAF1FB;
}

.v1-info-icon--date {
  background: #FFF4E5;
}

.v1-info-icon--route {
  background: #EAF8F2;
}

.v1-info-icon--passenger {
  background: #EAF1FB;
}

.v1-info-icon--notice {
  background: #FFF8E8;
}

.v1-info-icon__glyph {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}

.v1-info-icon__glyph--time {
  border: 3rpx solid #003087;
  border-radius: 50%;
}

.v1-info-icon__glyph--time::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 11rpx;
  width: 3rpx;
  height: 10rpx;
  background: #003087;
  border-radius: 2rpx;
}

.v1-info-icon__glyph--date {
  border: 3rpx solid #E67E22;
  border-radius: 6rpx;
}

.v1-info-icon__glyph--date::before {
  content: '';
  position: absolute;
  top: -3rpx;
  left: 5rpx;
  width: 4rpx;
  height: 8rpx;
  background: #E67E22;
  border-radius: 2rpx;
  box-shadow: 10rpx 0 0 #E67E22;
}

/* Folded map icon */
.v1-info-icon__glyph--map {
  width: 22rpx;
  height: 18rpx;
  border: 3rpx solid #1B9B63;
  border-radius: 4rpx 4rpx 2rpx 4rpx;
  box-sizing: border-box;
  background: linear-gradient(
    135deg,
    rgba(27, 155, 99, 0.12) 0%,
    rgba(27, 155, 99, 0.12) 48%,
    transparent 48%,
    transparent 100%
  );
}

.v1-info-icon__glyph--map::after {
  content: '';
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 6rpx;
  height: 6rpx;
  background: #FF6B4A;
  border: 2rpx solid #FFFFFF;
  border-radius: 50%;
  box-sizing: border-box;
}

/* Passenger badge icon */
.v1-info-icon__glyph--passenger {
  width: 22rpx;
  height: 22rpx;
}

.v1-info-icon__glyph--passenger::before {
  content: '';
  position: absolute;
  top: 1rpx;
  left: 6rpx;
  width: 10rpx;
  height: 10rpx;
  background: #003087;
  border-radius: 50%;
}

.v1-info-icon__glyph--passenger::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 2rpx;
  width: 18rpx;
  height: 9rpx;
  background: #003087;
  border-radius: 9rpx 9rpx 0 0;
}

/* Notice / attention icon */
.v1-info-icon__glyph--notice {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #E67E22;
  border-radius: 50%;
  box-sizing: border-box;
}

.v1-info-icon__glyph--notice::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 9rpx;
  width: 4rpx;
  height: 9rpx;
  background: #E67E22;
  border-radius: 2rpx;
}

.v1-info-icon__glyph--notice::before {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 9rpx;
  width: 4rpx;
  height: 4rpx;
  background: #E67E22;
  border-radius: 50%;
}

.v1-info-main {
  flex: 1;
  min-width: 0;
}

.v1-info-label {
  display: block;
  font-size: 22rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.35;
}

.v1-info-value {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
  word-break: break-all;
}

.v1-info-value--emphasis {
  font-size: 34rpx;
  font-weight: 700;
  color: #003087;
}

.v1-route-stack {
  margin-top: 6rpx;
}

.v1-route-line {
  display: flex;
  align-items: flex-start;
  min-height: 40rpx;
}

.v1-route-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 10rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.v1-route-dot--start {
  background: #22B573;
}

.v1-route-dot--end {
  background: #FF6B4A;
}

.v1-route-connector {
  width: 2rpx;
  height: 20rpx;
  margin: 2rpx 0 2rpx 5rpx;
  background: #E3E7EC;
}

.v1-route-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
  word-break: break-all;
}

.v1-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.v1-tag {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 6rpx 12rpx;
  background: #FFF8E8;
  border: 1rpx solid #F7DFA3;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #8B6914;
  line-height: 1.4;
  box-sizing: border-box;
  word-break: break-all;
}

/* Actions — 自定义行 / 三层 fallback */
.v1-actions {
  margin: 32rpx 28rpx 0;
}

.v1-actions__row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.v1-actions__row:first-child {
  margin-top: 0;
}

.v1-btn--half {
  flex: 1;
  width: auto;
  margin: 0;
  min-width: 0;
  font-size: 26rpx;
}

.v1-actions__row .v1-btn--primary,
.v1-actions__row .v1-btn--accent {
  font-size: 28rpx;
  font-weight: 600;
}

.v1-actions__primary .v1-btn {
  margin-top: 0;
}

.v1-actions__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.v1-actions__grid--single .v1-btn--grid {
  width: 100%;
}

.v1-actions__danger {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #EAECF0;
}

.v1-btn {
  display: block;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin: 12rpx 0 0;
  padding: 0;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.v1-btn--grid {
  width: calc(50% - 6rpx);
  margin: 0;
  font-size: 26rpx;
  font-weight: 500;
}

.v1-actions__grid .v1-btn--grid:last-child:nth-child(odd):not(:only-child) {
  width: 100%;
}

.v1-actions__danger .v1-btn {
  margin-top: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.v1-btn::after {
  border: none;
}

.v1-btn[disabled] {
  opacity: 0.55;
}

.v1-btn--accent {
  background: #FF6B4A;
  color: #FFFFFF;
}

.v1-btn--primary {
  background: #003087;
  color: #FFFFFF;
}

.v1-btn--secondary {
  background: #FFFFFF;
  color: #1F2937;
  border: 1rpx solid #E7ECF2;
}

.v1-btn--danger {
  background: #FFFFFF;
  color: #C4473A;
  border: 1rpx solid #F0D4D0;
  font-weight: 500;
}
