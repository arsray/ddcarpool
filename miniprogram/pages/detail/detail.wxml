<view class="container">
  <block wx:if="{{loading}}">
    <view class="empty-state">加载中…</view>
  </block>

  <block wx:elif="{{order}}">
    <view class="card">
      <view class="status-row">
        <text class="status-tag">{{statusLabel}}</text>
        <text class="role-tag" wx:if="{{isPassenger}}">我发布的</text>
        <text class="role-tag" wx:elif="{{isAssignedDriver}}">我已接单</text>
      </view>
      <view class="route">{{routeLabel}}</view>
      <view class="hint" wx:if="{{order.status === 'matching' && isPassenger}}">等待司机在广场接单</view>
      <view class="hint" wx:elif="{{order.status === 'matching' && canAccept}}">确认顺路后可接单</view>
      <view class="hint" wx:elif="{{order.status === 'pending_departure'}}">已接单，请按出发时间窗出行</view>
    </view>

    <view class="card">
      <view class="info-row">
        <text class="info-label">出发时间窗</text>
        <text class="info-value">{{departTimeLabel}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">出行人数</text>
        <text class="info-value">{{order.passengerCount}} 人</text>
      </view>
      <view class="info-row">
        <text class="info-label">乘客</text>
        <text class="info-value">{{order.passengerName}}</text>
      </view>
      <view class="info-row" wx:if="{{order.driverName}}">
        <text class="info-label">司机</text>
        <text class="info-value">{{order.driverName}}</text>
      </view>
      <view class="info-row" wx:if="{{order.note}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.note}}</text>
      </view>
    </view>

    <button
      wx:if="{{canAccept}}"
      class="btn-primary"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onAccept"
    >确认接单</button>

    <button wx:if="{{isPassenger || isAssignedDriver}}" class="btn-primary" bindtap="goHistory">查看我的订单</button>
    <button wx:if="{{fromPlaza && order.status !== 'matching'}}" class="btn-secondary" bindtap="backToPlaza">返回广场</button>
  </block>
</view>
