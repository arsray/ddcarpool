<wxs module="fmt">
function splitNote(note) {
  if (!note) return []
  var parts = note.split(' · ')
  var out = []
  for (var i = 0; i < parts.length; i++) {
    if (parts[i]) out.push(parts[i])
  }
  return out
}
module.exports.splitNote = splitNote
</wxs>

<view class="v1-detail-page container">
  <block wx:if="{{loading}}">
    <view class="v1-empty">加载中…</view>
  </block>

  <block wx:elif="{{order}}">
    <view class="v1-status-header v1-status-header--{{order.status}}">
      <image
        class="v1-status-header__watermark"
        src="{{headerWatermark}}"
        mode="aspectFit"
        aria-hidden="true"
      />
      <view class="v1-status-header__inner">
        <text class="v1-status-header__role" wx:if="{{roleLabel}}">{{roleLabel}}</text>
        <text class="v1-status-header__status">{{statusLabel}}</text>
        <text class="v1-status-header__hint" wx:if="{{statusHint}}">{{statusHint}}</text>
      </view>
    </view>

    <view class="v1-driver-card" wx:if="{{showDriverCard}}">
      <text class="v1-driver-card__title">车主信息</text>
      <view class="v1-driver-card__body">
        <view class="v1-driver-card__icon" aria-hidden="true">🚗</view>
        <view class="v1-driver-card__main">
          <text class="v1-driver-card__name">{{driverCard.driverName}}</text>
          <view class="v1-driver-card__vehicle">
            <text class="v1-driver-card__vehicle-item" wx:if="{{driverCard.brand}}">{{driverCard.brand}}</text>
            <text class="v1-driver-card__vehicle-item" wx:if="{{driverCard.plate}}">{{driverCard.plate}}</text>
            <text class="v1-driver-card__vehicle-item" wx:if="{{driverCard.color}}">{{driverCard.color}}</text>
            <text
              class="v1-driver-card__vehicle-item v1-driver-card__vehicle-item--muted"
              wx:if="{{!driverCard.brand && !driverCard.plate && !driverCard.color}}"
            >车辆信息待补充</text>
          </view>
        </view>
      </view>
    </view>

    <view class="v1-trip-card">
      <view class="v1-info-row">
        <view class="v1-info-icon v1-info-icon--time">
          <view class="v1-info-icon__glyph v1-info-icon__glyph--time"></view>
        </view>
        <view class="v1-info-main">
          <text class="v1-info-label">出发时间窗</text>
          <text class="v1-info-value v1-info-value--emphasis">{{timeWindowLabel}}</text>
        </view>
      </view>

      <view class="v1-info-row">
        <view class="v1-info-icon v1-info-icon--date">
          <view class="v1-info-icon__glyph v1-info-icon__glyph--date"></view>
        </view>
        <view class="v1-info-main">
          <text class="v1-info-label">出发日期</text>
          <text class="v1-info-value">{{dateWeekLabel}}</text>
        </view>
      </view>

      <view class="v1-info-row v1-info-row--route">
        <view class="v1-info-icon v1-info-icon--route">
          <view class="v1-info-icon__glyph v1-info-icon__glyph--map"></view>
        </view>
        <view class="v1-info-main">
          <text class="v1-info-label">路线</text>
          <view class="v1-route-stack">
            <view class="v1-route-line">
              <view class="v1-route-dot v1-route-dot--start"></view>
              <text class="v1-route-name">{{fromName}}</text>
            </view>
            <view class="v1-route-connector" wx:if="{{toName}}"></view>
            <view class="v1-route-line" wx:if="{{toName}}">
              <view class="v1-route-dot v1-route-dot--end"></view>
              <text class="v1-route-name">{{toName}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="v1-info-row {{order.note ? '' : 'v1-info-row--last'}}">
        <view class="v1-info-icon v1-info-icon--passenger">
          <view class="v1-info-icon__glyph v1-info-icon__glyph--passenger"></view>
        </view>
        <view class="v1-info-main">
          <text class="v1-info-label">乘客</text>
          <text class="v1-info-value">{{passengerLine}}</text>
        </view>
      </view>

      <view class="v1-info-row v1-info-row--note v1-info-row--last" wx:if="{{order.note}}">
        <view class="v1-info-icon v1-info-icon--notice">
          <view class="v1-info-icon__glyph v1-info-icon__glyph--notice"></view>
        </view>
        <view class="v1-info-main">
          <text class="v1-info-label">特殊要求</text>
          <view class="v1-tags">
            <view
              class="v1-tag"
              wx:for="{{fmt.splitNote(order.note)}}"
              wx:for-item="tag"
              wx:key="*this"
            >{{tag}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="v1-actions" wx:if="{{actions.length}}">
      <block wx:if="{{actionRows.length}}">
        <view
          class="v1-actions__row"
          wx:for="{{actionRows}}"
          wx:for-item="row"
          wx:for-index="rowIndex"
          wx:key="rowIndex"
        >
          <button
            wx:for="{{row}}"
            wx:for-item="item"
            wx:key="key"
            class="v1-btn v1-btn--{{item.variant}} v1-btn--half"
            loading="{{item.submitting && submitting}}"
            disabled="{{item.submitting && submitting}}"
            bindtap="onAction"
            data-action="{{item.key}}"
          >{{item.label}}</button>
        </view>
      </block>

      <block wx:else>
        <view class="v1-actions__primary" wx:if="{{actionGroups.primary.length}}">
          <button
            wx:for="{{actionGroups.primary}}"
            wx:key="key"
            class="v1-btn v1-btn--{{item.variant}}"
            loading="{{item.submitting && submitting}}"
            disabled="{{item.submitting && submitting}}"
            bindtap="onAction"
            data-action="{{item.key}}"
          >{{item.label}}</button>
        </view>

        <view
          class="v1-actions__grid {{actionGroups.secondary.length === 1 ? 'v1-actions__grid--single' : ''}}"
          wx:if="{{actionGroups.secondary.length}}"
        >
          <button
            wx:for="{{actionGroups.secondary}}"
            wx:key="key"
            class="v1-btn v1-btn--secondary v1-btn--grid"
            bindtap="onAction"
            data-action="{{item.key}}"
          >{{item.label}}</button>
        </view>
      </block>

      <view class="v1-actions__danger" wx:if="{{actionGroups.danger.length}}">
        <button
          wx:for="{{actionGroups.danger}}"
          wx:key="key"
          class="v1-btn v1-btn--danger"
          hover-class="none"
          disabled="{{submitting}}"
          bindtap="onCancel"
        >{{item.label}}</button>
      </view>
    </view>
  </block>
</view>
