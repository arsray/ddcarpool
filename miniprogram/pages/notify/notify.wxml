<wxs module="notifyFmt">
function iconType(title) {
  if (!title) return 'order'
  if (title.indexOf('消息') >= 0) return 'message'
  if (title.indexOf('完成') >= 0) return 'done'
  return 'order'
}

function summary(title) {
  if (!title) return '点击查看详情'
  if (title.indexOf('匹配超时') >= 0) return '出发时段内无人接单，订单已关闭'
  if (title.indexOf('重新匹配') >= 0) return '订单已回到广场，可查看详情'
  if (title.indexOf('待出发') >= 0) return '司机已接单，请查看出发安排'
  if (title.indexOf('已开始') >= 0) return '行程进行中，可查看详情或联系对方'
  if (title.indexOf('已完成') >= 0) return '行程已结束，可查看详情'
  if (title.indexOf('已关闭') >= 0) return '订单已关闭，可查看详情'
  if (title.indexOf('消息') >= 0) return '点击查看消息内容'
  return '点击查看详情'
}

module.exports.iconType = iconType
module.exports.summary = summary
</wxs>

<view class="container tab-page v1-notify-page">
  <view class="v1-page-head">
    <view class="v1-page-title">消息</view>
  </view>

  <view class="v1-role-seg" wx:if="{{showRoleTabs}}">
    <view
      class="v1-role-seg-item {{role==='owner'?'on owner':''}}"
      data-role="owner"
      bindtap="switchRole"
    >车主消息</view>
    <view
      class="v1-role-seg-item {{role==='passenger'?'on passenger':''}}"
      data-role="passenger"
      bindtap="switchRole"
    >乘车人消息</view>
  </view>
  <view wx:elif="{{role === 'owner'}}" class="v1-role-chip v1-role-chip--owner">车主消息</view>
  <view wx:else class="v1-role-chip v1-role-chip--passenger">乘车人消息</view>

  <block wx:if="{{list.length}}">
    <view class="v1-notify-list">
      <view
        class="v1-notify-item"
        wx:for="{{list}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTap"
      >
        <view class="v1-notify-icon v1-notify-icon--{{notifyFmt.iconType(item.title)}}">
          <block wx:if="{{notifyFmt.iconType(item.title) === 'message'}}">
            <view class="v1-icon-bubble"></view>
          </block>
          <block wx:elif="{{notifyFmt.iconType(item.title) === 'done'}}">
            <view class="v1-icon-check"></view>
          </block>
          <block wx:else>
            <view class="v1-icon-doc"></view>
            <view class="v1-icon-doc-line v1-icon-doc-line-1"></view>
            <view class="v1-icon-doc-line v1-icon-doc-line-2"></view>
          </block>
        </view>

        <view class="v1-notify-body">
          <view class="v1-notify-top">
            <text class="v1-notify-title {{item.read ? '' : 'v1-notify-title--unread'}}">{{item.title}}</text>
            <text class="v1-notify-time">{{item.time}}</text>
          </view>
          <text class="v1-notify-sub">{{notifyFmt.summary(item.title)}}</text>
        </view>

        <text class="v1-notify-arrow">›</text>
      </view>
    </view>
  </block>

  <view class="v1-empty" wx:else>
    <view class="v1-empty-title">暂无消息</view>
    <view class="v1-empty-sub">新的订单通知和消息会显示在这里</view>
  </view>

  <view class="tab-bottom-spacer"></view>
</view>
