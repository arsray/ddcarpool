@import '../mine/m1-shared.wxss';

.order-card {
  position: relative;
  margin-bottom: 0;
  border-radius: 16rpx 16rpx 0 0;
  padding-bottom: 8rpx;
}

.source-corner {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 16rpx 0 8rpx;
  background: #f1f5f9;
  color: #475569;
  font-weight: 600;
  z-index: 1;
}

.detail-head {
  margin-bottom: 24rpx;
  padding-right: 72rpx;
}

.status-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
  line-height: 1.5;
}

.status-sub {
  font-size: 26rpx;
  color: #64748b;
}

.detail-section {
  padding: 20rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.detail-section:first-of-type {
  border-top: none;
  padding-top: 0;
}

.detail-label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #1a2332;
  line-height: 1.5;
  word-break: break-all;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  background: #fff;
  border-radius: 0 0 16rpx 16rpx;
  padding: 0 24rpx 24rpx;
  margin-top: -4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.action-bar.single {
  justify-content: stretch;
}

.action-bar.single .action-btn {
  flex: 1;
}

.action-bar-3 {
  flex-wrap: wrap;
}

.action-bar-3 .action-btn {
  flex: 1 1 calc(33.33% - 12rpx);
  min-width: 180rpx;
  font-size: 24rpx;
  padding-left: 8rpx;
  padding-right: 8rpx;
}

.action-btn {
  flex: 1;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin: 0;
}

.action-btn.default { background:#4f46e5; color:#fff; }
.action-btn.success { background:#059669; color:#fff; }
.action-btn.danger { background:#ef4444; color:#fff; }
.action-btn::after { border:none; }
