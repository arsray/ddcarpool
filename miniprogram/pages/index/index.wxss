.hero-card {
  background: var(--color-primary-light);
  border-radius: var(--radius-lg);
  padding: 24rpx var(--space-lg);
  margin-bottom: 16rpx;
}

.filter-panel {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 20rpx 22rpx 18rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e8edf3;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.filter-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.filter-panel-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
}

.filter-hint {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.filter-reset {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #2563eb;
  padding-top: 2rpx;
}

.filter-row {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-picker {
  flex: 1;
  min-width: 0;
}

.filter-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
}

.filter-key {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #64748b;
}

.filter-val {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #0f172a;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
}

.order-section-subtitle {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.order-section-title-gap {
  margin-top: 20rpx;
}

.accepted-section {
  margin-bottom: 0;
}

.section-divider {
  height: 1rpx;
  background: #e2e8f0;
  margin: 20rpx 0 24rpx;
}

.order-list-hint {
  margin: -4rpx 0 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.accepted-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 10rpx;
}

.accepted-card:active {
  opacity: 0.92;
}

.accepted-main {
  flex: 1;
  min-width: 0;
}

.accepted-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
}

.accepted-route {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.accepted-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #94a3b8;
  line-height: 1;
}

.order-section-empty {
  margin-bottom: 12rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  background: #f8fafc;
  border-radius: 12rpx;
}

.order-list {
  margin-top: 4rpx;
}

.list-end {
  text-align: center;
  padding: 32rpx 0 16rpx;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.page-locked {
  overflow: hidden;
  height: 100vh;
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  box-sizing: border-box;
}

.hero-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-primary);
}

.hero-todo-hint {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d4ed8;
  line-height: 1.5;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.hero-todo-hint + .hero-desc {
  margin-top: 6rpx;
}

.order-card {
  position: relative;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 48, 135, 0.06);
}

.order-body {
  padding-right: 108rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

.order-line {
  line-height: 1.35;
}

.card-footer {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  margin: 0;
  padding: 0;
  width: auto;
  line-height: 0;
}

.order-line + .order-line {
  margin-top: 6rpx;
}

.schedule-line {
  display: flex;
  align-items: center;
  min-height: 36rpx;
  padding-right: 8rpx;
}

.schedule-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.route {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.meta-line {
  font-size: 24rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.accept-btn-card {
  margin: 0;
  width: 88rpx !important;
  min-width: 0 !important;
  height: 48rpx;
  padding: 0;
  background: var(--color-primary, #003087);
  color: #fff;
  font-size: 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
  flex-shrink: 0;
}

.accept-btn-card::after {
  border: none;
}

.accept-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.accept-dialog {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.accept-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.accept-desc {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #64748b;
}

.accept-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.accept-row:last-of-type {
  margin-bottom: 8rpx;
}

.accept-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #64748b;
}

.accept-value {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
  line-height: 1.5;
  word-break: break-all;
}

.accept-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.accept-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  padding: 0;
  font-size: 28rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.accept-btn::after {
  border: none;
}

.accept-btn.ghost {
  background: #f8fafc;
  color: #64748b;
}

.accept-btn.primary {
  background: var(--color-primary, #003087);
  color: #fff;
}

.btn-secondary {
  margin-top: 24rpx;
  background: #fff;
  color: var(--color-primary, #003087);
  border: 1rpx solid #bfdbfe;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary.ghost {
  margin-top: 16rpx;
  background: transparent;
  color: #64748b;
  border-color: #e2e8f0;
}
