  background: transparent;
  color: #64748b;
  border-color: #e2e8f0;
}
/* ===== M2 Homepage UI Prototype ===== */

.m2-home {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
  background: #f6f7f9;
}

.m2-mode-switch {
  display: flex;
  width: 320rpx;
  padding: 2rpx;
  margin-bottom: 20rpx;
  background: #eef1f4;
  border-radius: 999rpx;
}

.m2-mode-item {
  flex: 1;
  padding: 8rpx 10rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #667085;
  border-radius: 999rpx;
}

.m2-mode-item.active {
  background: #ffffff;
  color: #111827;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.m2-notice {
  padding: 20rpx 22rpx;
  margin-bottom: 28rpx;
  background: #fff7e8;
  border-radius: 20rpx;
  border: 1rpx solid #ffe1a8;
}

.m2-notice-title {
  display: flex;
  align-items: center;
  gap: 0;
  height: 36rpx;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.m2-notice-icon {
  font-size: 28rpx;
}

.m2-notice-content {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.55;
  color: #5f4b22;
}

.m2-section-head,
.m2-ranking-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.m2-section-head {
  margin: 8rpx 2rpx 18rpx;
}

.m2-section-title {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #111827;
}

.m2-section-subtitle {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a8f98;
}

.m2-section-more {
  padding-top: 8rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8a8f98;
}

.m2-order-card {
  position: relative;
  padding: 24rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #eceff3;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.045);
}

.m2-order-time {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.m2-route-row {
  display: flex;
  align-items: stretch;
}

.m2-route-visual {
  width: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.m2-route-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.m2-route-dot.start,
.m2-field-dot.start {
  background: #19be6b;
}

.m2-route-dot.end,
.m2-field-dot.end {
  background: #ff6b45;
}

.m2-route-line {
  width: 2rpx;
  flex: 1;
  min-height: 42rpx;
  margin: 5rpx 0;
  background: #d9dee5;
}

.m2-route-content {
  flex: 1;
  min-width: 0;
  padding-left: 10rpx;
  padding-right: 140rpx;
}

.m2-route-point {
  min-height: 48rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #22252a;
}

.m2-route-point.destination {
  margin-top: 12rpx;
}

.m2-system-tags,
.m2-custom-tags,
.m2-demand-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.m2-system-tags {
  margin-top: 20rpx;
}

.m2-custom-tags {
  margin-top: 12rpx;
  padding-right: 130rpx;
}

.m2-tag {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 1;
}

.m2-tag.system {
  color: #475467;
  background: #f2f4f7;
}

.m2-tag.match {
  color: #16864f;
  background: #eaf8f1;
}

.m2-tag.match.perfect {
  color: #087443;
  background: #dff7ea;
  font-weight: 700;
}

.m2-tag.custom {
  color: #8a5a13;
  background: #fff6dc;
}

.m2-accept-btn {
  position: absolute;
  right: 22rpx;
  bottom: 24rpx;
  width: 112rpx !important;
  height: 62rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #ff6b45;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 62rpx;
}

.m2-accept-btn::after,
.m2-primary-btn::after {
  border: none;
}

.m2-trip-card,
.m2-ranking-card {
  padding: 26rpx 24rpx;
  margin-top: 28rpx;
  background: #ffffff;
  border-radius: 26rpx;
  border: 1rpx solid #eceff3;
  box-shadow: 0 6rpx 22rpx rgba(15, 23, 42, 0.045);
}

.m2-trip-card.passenger {
  margin-top: 4rpx;
}

.m2-trip-fields {
  margin-top: 22rpx;
  border: 1rpx solid #eaecf0;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
}

.m2-trip-field {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.m2-field-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.m2-time-icon,
.m2-passenger-icon {
  width: 34rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 28rpx;
  color: #667085;
}

.m2-field-main {
  flex: 1;
  min-width: 0;
}

.m2-field-label {
  font-size: 22rpx;
  color: #98a2b3;
}

.m2-field-value {
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  font-weight: 600;
  color: #24272c;
}

.m2-field-arrow {
  margin-left: 16rpx;
  flex-shrink: 0;
  font-size: 34rpx;
  color: #b5bbc5;
}

.m2-trip-divider {
  height: 1rpx;
  margin-left: 52rpx;
  background: #eff1f4;
}

.m2-primary-btn {
  width: 100%;
  height: 84rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: #ff6b45;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.m2-demand-title {
  margin-top: 24rpx;
  margin-bottom: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #475467;
}

.m2-tag.demand {
  color: #475467;
  background: #f4f5f7;
  border: 1rpx solid #e8eaee;
}

.m2-tag.demand.add {
  color: #ff6b45;
  background: #fff7f3;
  border-color: #ffd4c7;
}

.m2-ranking-card {
  margin-bottom: 10rpx;
}

.m2-unlocked-badge {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf8f1;
  color: #16864f;
  font-size: 21rpx;
}

.m2-ranking-tabs {
  display: flex;
  padding: 5rpx;
  margin-top: 22rpx;
  margin-bottom: 14rpx;
  background: #f2f4f7;
  border-radius: 16rpx;
}

.m2-ranking-tab {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  color: #7a818b;
}

.m2-ranking-tab.active {
  background: #ffffff;
  color: #111827;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.07);
}

.m2-ranking-row {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.m2-ranking-row:last-child {
  border-bottom: none;
}

.m2-ranking-position {
  width: 64rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: #ff8a3d;
}

.m2-ranking-name {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  color: #2b2f35;
}

.m2-ranking-merit {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #16864f;
}

.m2-ranking-lock {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 20rpx 12rpx 4rpx;
  border-top: 1rpx solid #f0f1f3;
  font-size: 24rpx;
  color: #667085;
}

.m2-ranking-lock text {
  font-size: 30rpx;
  color: #b0b5bd;
}

.m2-promo-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.46);
}

.m2-promo-modal {
  position: relative;
  width: 100%;
  padding: 40rpx 30rpx 30rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #ffffff;
}

.m2-promo-close {
  position: absolute;
  top: 12rpx;
  right: 20rpx;
  width: 54rpx;
  height: 54rpx;
  text-align: center;
  font-size: 42rpx;
  line-height: 54rpx;
  color: #98a2b3;
}

.m2-promo-placeholder {
  padding: 46rpx 24rpx;
  text-align: center;
  border-radius: 22rpx;
  background: #f6f7f9;
}

.m2-promo-icon {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #ff6b45;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 84rpx;
  text-align: center;
}

.m2-promo-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #20242a;
}

.m2-promo-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #858b95;
}

.m2-home .list-bottom-spacer {
  height: 80rpx;
}

