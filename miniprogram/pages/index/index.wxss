/* ===== DDCarpool V1 — 车主页生产 UI ===== */

.v1-owner-page.container.tab-page {
  padding: 16rpx 28rpx var(--space-md, 24rpx);
  background: #F5F7FA;
  box-sizing: border-box;
}

.v1-owner-page .page-locked {
  overflow: hidden;
  height: 100vh;
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  box-sizing: border-box;
}

/* Role badge */
.v1-role-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: #EAF1FB;
  color: #003087;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

/* Notice bar */
.v1-notice {
  display: flex;
  align-items: center;
  height: 62rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: #FFF8E8;
  border: 1rpx solid #F7DFA3;
  border-radius: 18rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.v1-notice-scroll {
  flex: 1;
  min-width: 0;
  height: 36rpx;
  overflow: hidden;
  white-space: nowrap;
}

.v1-notice-content {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  white-space: nowrap;
  line-height: 36rpx;
}

.v1-notice-label {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #1F2937;
}

.v1-notice-text {
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
}

.v1-notice-content.scrolling {
  animation: v1NoticeScroll 12s linear infinite;
}

@keyframes v1NoticeScroll {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(-100%);
  }
}

/* Section titles */
.v1-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.35;
}

.v1-section-subtitle {
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  margin-bottom: 12rpx;
}

.v1-section-subtitle--gap {
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

/* Accepted orders */
.v1-accepted-section {
  margin-bottom: 0;
}

.v1-accepted-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 22rpx;
  margin-top: 12rpx;
  background: #EAF1FB;
  border: 1rpx solid #D6E6FA;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-accepted-card:active {
  opacity: 0.92;
}

.v1-accepted-main {
  flex: 1;
  min-width: 0;
}

.v1-accepted-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #98A2B3;
  line-height: 1;
}

.v1-section-divider {
  height: 1rpx;
  background: #E7ECF2;
  margin: 20rpx 0;
}

/* Filter panel */
.v1-filter-panel {
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.v1-filter-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.v1-filter-reset {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 400;
  color: #003087;
}

.v1-filter-sub {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.4;
}

.v1-filter-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.v1-filter-picker {
  width: calc(50% - 6rpx);
  min-width: 0;
  box-sizing: border-box;
}

.v1-filter-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 16rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.v1-filter-key {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
}

.v1-filter-val {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}

.v1-filter-picker--search {
  position: relative;
  z-index: 20;
}

.v1-filter-picker--search:focus-within {
  z-index: 40;
}

.v1-filter-search {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 16rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.v1-filter-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #1F2937;
  text-align: right;
}

.v1-filter-suggestions {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 8rpx);
  z-index: 50;
  max-height: 320rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7ECF2;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(16, 24, 40, 0.08);
  box-sizing: border-box;
}

.v1-filter-suggestion {
  padding: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #1F2937;
  border-bottom: 1rpx solid #F1F5F9;
}

.v1-filter-suggestion:last-child {
  border-bottom: none;
}

/* Order pool header */
.v1-pool-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
  box-sizing: border-box;
}

.v1-pool-head-main {
  flex: 1;
  min-width: 0;
}

.v1-pool-hint {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.4;
}

.v1-pool-count {
  flex-shrink: 0;
  padding-top: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  white-space: nowrap;
}

.v1-order-list {
  margin-top: 0;
}

/* Order card */
.v1-order-card {
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.v1-order-time {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.3;
}

.v1-order-count {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  background: #F5F7FA;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
}

/* Route */
.v1-route {
  margin-bottom: 14rpx;
}

.v1-route--compact {
  margin-top: 10rpx;
  margin-bottom: 0;
}

.v1-route-row {
  display: flex;
  align-items: center;
  min-height: 40rpx;
}

.v1-route-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.v1-route-dot--start {
  background: #22B573;
}

.v1-route-dot--end {
  background: #FF6B4A;
}

.v1-route-connector {
  width: 2rpx;
  height: 20rpx;
  margin: 2rpx 0 2rpx 5rpx;
  background: #E3E7EC;
}

.v1-route-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Order meta + CTA */
.v1-order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.v1-order-foot--has-tags {
  align-items: flex-end;
}

.v1-order-meta-col {
  flex: 1;
  min-width: 0;
}

.v1-order-name {
  display: block;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
}

.v1-order-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 8rpx;
  max-width: 100%;
}

.v1-order-tag {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 4rpx 12rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.v1-accept-btn {
  flex-shrink: 0;
  align-self: flex-end;
  margin: 0;
  width: 168rpx;
  min-width: 168rpx;
  max-width: 168rpx;
  height: 54rpx;
  padding: 0;
  background: #FF6B4A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 54rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.v1-accept-btn::after {
  border: none;
}

/* Empty states */
.v1-empty {
  padding: 64rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.5;
}

.v1-empty--inline {
  padding: 24rpx 16rpx;
  margin-bottom: 14rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
}

.v1-empty--compact {
  padding: 48rpx 24rpx;
}

.v1-btn-secondary {
  margin-top: 24rpx;
  background: #FFFFFF;
  color: #003087;
  border: 1rpx solid #D6E6FA;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.v1-btn-secondary::after {
  border: none;
}

.v1-btn-secondary--ghost {
  margin-top: 16rpx;
  background: transparent;
  color: #667085;
  border-color: #E7ECF2;
}

.v1-list-end {
  padding: 32rpx 0 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.5;
}

/* Accept modal */
.v1-accept-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(15, 23, 42, 0.45);
  box-sizing: border-box;
}

.v1-accept-dialog {
  width: 100%;
  max-width: 640rpx;
  padding: 36rpx 32rpx 28rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.v1-accept-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}

.v1-accept-desc {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
}

.v1-accept-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.v1-accept-label {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 400;
  color: #667085;
}

.v1-accept-value {
  flex: 1;
  font-size: 26rpx;
  font-weight: 400;
  color: #1F2937;
  line-height: 1.5;
  word-break: break-all;
}

.v1-accept-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.v1-accept-action {
  flex: 1;
  margin: 0;
  height: 80rpx;
  padding: 0;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.v1-accept-action::after {
  border: none;
}

.v1-accept-action--ghost {
  background: #F8FAFC;
  color: #667085;
}

.v1-accept-action--primary {
  background: #FF6B4A;
  color: #FFFFFF;
}

