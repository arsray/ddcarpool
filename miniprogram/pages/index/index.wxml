<page-meta page-style="{{acceptModalVisible ? 'overflow:hidden;height:100%;' : ''}}" />

<view class="container tab-page {{acceptModalVisible ? 'page-locked' : ''}}">
  <view class="hero-card">
    <view class="hero-title">{{heroTitle}}</view>
    <view class="hero-todo-hint" wx:if="{{heroTodoHint}}">{{heroTodoHint}}</view>
    <view class="hero-desc">{{heroDesc}}</view>
  </view>

  <view class="accepted-section" wx:if="{{hasOwnerIdentity && !isPassengerOnly && !loading && acceptedOrders.length}}">
    <view class="order-section-title">已接单 · 待出发</view>
    <view
      class="accepted-card"
      wx:for="{{acceptedOrders}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goAcceptedDetail"
    >
      <view class="accepted-main">
        <view class="accepted-time">{{item.dateLabel}} · {{item.timeLabel}}</view>
        <view class="accepted-route">{{item.routeLabel}}</view>
      </view>
      <text class="accepted-arrow">›</text>
    </view>
  </view>

  <view class="filter-panel" wx:if="{{hasOwnerIdentity && !isPassengerOnly && !loading}}">
    <view class="filter-panel-head">
      <view class="filter-panel-title">筛选条件</view>
      <text class="filter-reset" wx:if="{{hasActiveFilters}}" bindtap="onResetFilters">清除</text>
    </view>
    <view class="filter-hint">可选择预计出发时间及地点，以匹配符合条件的订单</view>
    <view class="filter-row">
      <picker class="filter-picker" mode="selector" range="{{filterDateLabels}}" value="{{filterDateIndex}}" bindchange="onFilterDateChange">
        <view class="filter-chip">
          <text class="filter-key">日期</text>
          <text class="filter-val">{{filterDateLabels[filterDateIndex]}}</text>
        </view>
      </picker>
      <picker class="filter-picker" mode="selector" range="{{filterTimeLabels}}" value="{{filterTimeIndex}}" bindchange="onFilterTimeChange">
        <view class="filter-chip">
          <text class="filter-key">时间</text>
          <text class="filter-val">{{filterTimeLabels[filterTimeIndex]}}</text>
        </view>
      </picker>
    </view>
    <view class="filter-row">
      <picker class="filter-picker" mode="selector" range="{{filterFromLabels}}" value="{{filterFromIndex}}" bindchange="onFilterFromChange">
        <view class="filter-chip">
          <text class="filter-key">出发</text>
          <text class="filter-val">{{filterFromLabels[filterFromIndex]}}</text>
        </view>
      </picker>
      <picker class="filter-picker" mode="selector" range="{{filterToLabels}}" value="{{filterToIndex}}" bindchange="onFilterToChange">
        <view class="filter-chip">
          <text class="filter-key">到达</text>
          <text class="filter-val">{{filterToLabels[filterToIndex]}}</text>
        </view>
      </picker>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="empty-state">加载中…</view>
  </block>

  <block wx:elif="{{isPassengerOnly}}">
    <view class="empty-state">
      <view>当前为乘车人身份，无法在广场接单</view>
      <button class="btn-secondary" bindtap="goPublish">去发布搭车单</button>
      <button class="btn-secondary ghost" bindtap="goAddOwnerIdentity">添加车主身份</button>
    </view>
  </block>

  <block wx:elif="{{!isPassengerOnly && !loading}}">
    <view class="order-list">
      <block wx:if="{{allOrders.length}}">
        <view class="order-section-title">匹配中</view>
        <block wx:if="{{hasActiveFilters}}">
          <view class="order-section-subtitle">符合条件</view>
          <view class="order-section-empty" wx:if="{{!matchedOrders.length}}">暂无完全符合条件的订单</view>
          <view class="order-card" wx:for="{{matchedOrders}}" wx:key="_id">
            <view class="order-body">
              <view class="order-line schedule-line">
                <text class="schedule-text">{{item.dateLabel}} · {{item.timeLabel}}</text>
              </view>
              <view class="order-line route">{{item.routeLabel}}</view>
              <view class="order-line meta-line">
                <text>{{item.passengerName}} · {{item.passengerCount}} 人</text>
                <text wx:if="{{item.note}}"> · {{item.note}}</text>
              </view>
            </view>
            <view class="card-footer">
              <button class="accept-btn-card" catchtap="onOpenAccept" data-id="{{item._id}}">接单</button>
            </view>
          </view>

          <view class="order-section-subtitle order-section-title-gap" wx:if="{{otherOrders.length}}">其他匹配中订单</view>
          <view class="order-card" wx:for="{{otherOrders}}" wx:key="_id">
            <view class="order-body">
              <view class="order-line schedule-line">
                <text class="schedule-text">{{item.dateLabel}} · {{item.timeLabel}}</text>
              </view>
              <view class="order-line route">{{item.routeLabel}}</view>
              <view class="order-line meta-line">
                <text>{{item.passengerName}} · {{item.passengerCount}} 人</text>
                <text wx:if="{{item.note}}"> · {{item.note}}</text>
              </view>
            </view>
            <view class="card-footer">
              <button class="accept-btn-card" catchtap="onOpenAccept" data-id="{{item._id}}">接单</button>
            </view>
          </view>
        </block>

        <block wx:else>
          <view class="order-card" wx:for="{{matchedOrders}}" wx:key="_id">
            <view class="order-body">
              <view class="order-line schedule-line">
                <text class="schedule-text">{{item.dateLabel}} · {{item.timeLabel}}</text>
              </view>
              <view class="order-line route">{{item.routeLabel}}</view>
              <view class="order-line meta-line">
                <text>{{item.passengerName}} · {{item.passengerCount}} 人</text>
                <text wx:if="{{item.note}}"> · {{item.note}}</text>
              </view>
            </view>
            <view class="card-footer">
              <button class="accept-btn-card" catchtap="onOpenAccept" data-id="{{item._id}}">接单</button>
            </view>
          </view>
        </block>
      </block>

      <view class="empty-state compact" wx:elif="{{!acceptedOrders.length}}">
        <view>暂无匹配中订单</view>
        <button class="btn-secondary" bindtap="goPublish">去发布搭车单</button>
      </view>

      <view class="list-end" wx:if="{{acceptedOrders.length || allOrders.length}}">～已经到底啦～</view>
      <view class="list-bottom-spacer" wx:if="{{acceptedOrders.length || allOrders.length}}"></view>
    </view>
  </block>
</view>

<view
  class="accept-mask"
  wx:if="{{acceptModalVisible}}"
  bindtap="closeAcceptModal"
  catchtouchmove="noop"
>
  <view class="accept-dialog" catchtap="noop">
    <view class="accept-title">确认接单</view>
    <view class="accept-desc">请确认以下订单信息</view>

    <view class="accept-row">
      <text class="accept-label">日期</text>
      <text class="accept-value">{{acceptDateLabel}}</text>
    </view>
    <view class="accept-row">
      <text class="accept-label">时间</text>
      <text class="accept-value">{{acceptTimeLabel}}</text>
    </view>
    <view class="accept-row">
      <text class="accept-label">路线</text>
      <text class="accept-value">{{acceptModalOrder.routeLabel}}</text>
    </view>
    <view class="accept-row">
      <text class="accept-label">乘车人</text>
      <text class="accept-value">{{acceptModalOrder.passengerName}}</text>
    </view>
    <view class="accept-row">
      <text class="accept-label">人数</text>
      <text class="accept-value">{{acceptModalOrder.passengerCount}} 人</text>
    </view>
    <view class="accept-row">
      <text class="accept-label">备注</text>
      <text class="accept-value">{{acceptModalOrder.note || '无'}}</text>
    </view>

    <view class="accept-actions">
      <button class="accept-btn ghost" bindtap="closeAcceptModal" disabled="{{accepting}}">取消</button>
      <button class="accept-btn primary" bindtap="confirmAccept" loading="{{accepting}}" disabled="{{accepting}}">确认接单</button>
    </view>
  </view>
</view>
