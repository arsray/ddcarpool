<page-meta page-style="{{acceptModalVisible ? 'overflow:hidden;height:100%;' : ''}}" />
<!-- ===== M2 Homepage UI Prototype ===== -->

<view class="m2-home tab-page" wx:if="{{uiPrototypeMode}}">

  <!-- 车主 / 乘客切换 -->
  <view class="m2-mode-switch">
    <view
      class="m2-mode-item {{userMode === 'owner' ? 'active' : ''}}"
      data-mode="owner"
      bindtap="switchUserMode"
    >
      车主
    </view>

    <view
      class="m2-mode-item {{userMode === 'passenger' ? 'active' : ''}}"
      data-mode="passenger"
      bindtap="switchUserMode"
    >
      乘客
    </view>
  </view>


  <!-- 今日迪闻 -->
  <view class="m2-notice">
    <view class="m2-notice-title">
      <text class="m2-notice-icon">📢</text>
      <text class="m2-notice-title-text">今日迪闻：</text>
    </view>

    <view class="m2-notice-scroll">
      <view class="m2-notice-content {{noticeShouldScroll ? 'scrolling' : ''}}">
        {{noticeText}}
      </view>
    </view>
  </view>


  <!-- ==================== -->
  <!-- 车主模式 -->
  <!-- ==================== -->

  <block wx:if="{{userMode === 'owner'}}">

    <view class="m2-section-head">
      <view>
        <view class="m2-section-title">订单池</view>
        <view class="m2-section-subtitle">看看有没有顺路的小伙伴</view>
      </view>

      <text class="m2-section-more">查看全部 ›</text>
    </view>


    <!-- 三笔 UI Prototype 订单 -->

    <view
      class="m2-order-card"
      wx:for="{{prototypeOrders}}"
      wx:key="id"
    >

      <view class="m2-order-time">
        {{item.time}}
      </view>

      <view class="m2-route-row">
        <view class="m2-route-visual">
          <view class="m2-route-dot start"></view>
          <view class="m2-route-line"></view>
          <view class="m2-route-dot end"></view>
        </view>

        <view class="m2-route-content">
          <view class="m2-route-point">
            {{item.from}}
          </view>

          <view class="m2-route-point destination">
            {{item.to}}
          </view>
        </view>
      </view>


      <view class="m2-system-tags">

        <view class="m2-tag system">
          {{item.passengerCount}}人
        </view>

        <view class="m2-tag match {{item.matchScore === 100 ? 'perfect' : ''}}">
          顺路 {{item.matchScore}}%
        </view>

      </view>


      <view class="m2-custom-tags" wx:if="{{item.tags.length}}">
        <view
          class="m2-tag custom"
          wx:for="{{item.tags}}"
          wx:for-item="tag"
          wx:key="*this"
        >
          {{tag}}
        </view>
      </view>


      <button
        class="m2-accept-btn"
        bindtap="showPrototypeAccept"
      >
        接单
      </button>

    </view>


    <!-- 找顺路订单 -->

    <view class="m2-trip-card">

      <view class="m2-section-title">
        找顺路订单
      </view>

      <view class="m2-section-subtitle">
        输入你的行程，我们帮你筛一筛
      </view>


      <view class="m2-trip-fields">

        <picker
          mode="selector"
          range="{{prototypePoints}}"
          value="{{driverTripFromIndex}}"
          bindchange="onDriverFromChange"
        >

          <view class="m2-trip-field">
            <view class="m2-field-dot start"></view>

            <view class="m2-field-main">
              <view class="m2-field-label">起点</view>

              <view class="m2-field-value">
                {{prototypePoints[driverTripFromIndex]}}
              </view>
            </view>

            <text class="m2-field-arrow">›</text>
          </view>

        </picker>


        <view class="m2-trip-divider"></view>


        <picker
          mode="selector"
          range="{{prototypePoints}}"
          value="{{driverTripToIndex}}"
          bindchange="onDriverToChange"
        >

          <view class="m2-trip-field">

            <view class="m2-field-dot end"></view>

            <view class="m2-field-main">
              <view class="m2-field-label">终点</view>

              <view class="m2-field-value">
                {{prototypePoints[driverTripToIndex]}}
              </view>
            </view>

            <text class="m2-field-arrow">›</text>

          </view>

        </picker>


        <view class="m2-trip-divider"></view>


        <view class="m2-trip-field">

          <text class="m2-time-icon">◷</text>

          <view class="m2-field-main">
            <view class="m2-field-label">出发时间</view>

            <view class="m2-field-value">
              {{driverTripTime}}
            </view>
          </view>

          <text class="m2-field-arrow">›</text>

        </view>

      </view>


      <button
        class="m2-primary-btn"
        bindtap="showPrototypeMatch"
      >
        查看顺路订单
      </button>

    </view>

  </block>


  <!-- ==================== -->
  <!-- 乘客模式 -->
  <!-- ==================== -->

  <block wx:if="{{userMode === 'passenger'}}">

    <view class="m2-trip-card passenger">

      <view class="m2-section-title">
        发布我的行程
      </view>

      <view class="m2-section-subtitle">
        填写出发信息，等待顺路车主接单
      </view>


      <view class="m2-trip-fields">

        <picker
          mode="selector"
          range="{{prototypePoints}}"
          value="{{passengerFromIndex}}"
          bindchange="onPassengerFromChange"
        >

          <view class="m2-trip-field">

            <view class="m2-field-dot start"></view>

            <view class="m2-field-main">
              <view class="m2-field-label">起点</view>

              <view class="m2-field-value">
                {{prototypePoints[passengerFromIndex]}}
              </view>
            </view>

            <text class="m2-field-arrow">›</text>

          </view>

        </picker>


        <view class="m2-trip-divider"></view>


        <picker
          mode="selector"
          range="{{prototypePoints}}"
          value="{{passengerToIndex}}"
          bindchange="onPassengerToChange"
        >

          <view class="m2-trip-field">

            <view class="m2-field-dot end"></view>

            <view class="m2-field-main">
              <view class="m2-field-label">终点</view>

              <view class="m2-field-value">
                {{prototypePoints[passengerToIndex]}}
              </view>
            </view>

            <text class="m2-field-arrow">›</text>

          </view>

        </picker>


        <view class="m2-trip-divider"></view>


        <view class="m2-trip-field">
          <text class="m2-time-icon">◷</text>

          <view class="m2-field-main">
            <view class="m2-field-label">出发时间</view>

            <view class="m2-field-value">
              {{passengerTime}}
            </view>
          </view>

          <text class="m2-field-arrow">›</text>
        </view>


        <view class="m2-trip-divider"></view>


        <view class="m2-trip-field">

          <text class="m2-passenger-icon">👤</text>

          <view class="m2-field-main">
            <view class="m2-field-label">同行人数</view>

            <view class="m2-field-value">
              {{passengerCount}} 人
            </view>
          </view>

          <text class="m2-field-arrow">›</text>

        </view>

      </view>


      <view class="m2-demand-title">
        乘车需求
      </view>

      <view class="m2-demand-tags">

        <view
          class="m2-tag demand"
          wx:for="{{passengerTags}}"
          wx:key="*this"
        >
          {{item}}
        </view>

        <view class="m2-tag demand add">
          ＋ 自定义
        </view>

      </view>


      <button
        class="m2-primary-btn"
        bindtap="showPrototypePublish"
      >
        发布行程
      </button>

    </view>

  </block>


  <!-- ==================== -->
  <!-- 功德排行榜 -->
  <!-- ==================== -->

  <view class="m2-ranking-card">

    <view class="m2-ranking-head">

      <view>

        <view class="m2-section-title">
          🏆 功德排行榜
        </view>

        <view class="m2-section-subtitle">
          每一次顺路，都是一份功德
        </view>

      </view>

      <view
        class="m2-unlocked-badge"
        wx:if="{{rankingUnlocked}}"
      >
        ✓ 今日已解锁
      </view>

    </view>


    <view class="m2-ranking-tabs">

      <view
        class="m2-ranking-tab {{rankingTab === 'today' ? 'active' : ''}}"
        data-tab="today"
        bindtap="switchRankingTab"
      >
        今日榜
      </view>

      <view
        class="m2-ranking-tab {{rankingTab === 'total' ? 'active' : ''}}"
        data-tab="total"
        bindtap="switchRankingTab"
      >
        总榜
      </view>

    </view>


    <!-- 今日榜 -->

    <block wx:if="{{rankingTab === 'today'}}">

      <block wx:for="{{todayRanking}}" wx:key="rank">
  <view
    class="m2-ranking-row"
    wx:if="{{rankingUnlocked || item.rank <= 3}}"
  >
    <view class="m2-ranking-position">
      {{item.rank}}
    </view>

    <view class="m2-ranking-name">
      {{rankingUnlocked ? item.name : item.maskedName}}
    </view>

    <view class="m2-ranking-merit">
      {{item.merit}} 功德
    </view>
  </view>
</block>

</block>


    <!-- 总榜 -->

    <block wx:else>

<block wx:for="{{totalRanking}}" wx:key="rank">
  <view
    class="m2-ranking-row"
    wx:if="{{rankingUnlocked || item.rank <= 3}}"
  >
    <view class="m2-ranking-position">
      {{item.rank}}
    </view>

    <view class="m2-ranking-name">
      {{rankingUnlocked ? item.name : item.maskedName}}
    </view>

    <view class="m2-ranking-merit">
      {{item.merit}} 功德
    </view>
  </view>
</block>

</block>


    <view
      class="m2-ranking-lock"
      wx:if="{{!rankingUnlocked}}"
      bindtap="openPromoModal"
    >
      🔒 看广告解锁完整排行榜
      <text>›</text>
    </view>

  </view>


  <view class="list-bottom-spacer"></view>

</view>


<!-- 推广内容 Prototype -->

<view
  class="m2-promo-mask"
  wx:if="{{promoVisible}}"
  bindtap="closePromoModal"
>

  <view
    class="m2-promo-modal"
    catchtap="noop"
  >

    <view class="m2-promo-close" bindtap="closePromoModal">
      ×
    </view>

    <view class="m2-promo-placeholder">
      <view class="m2-promo-icon">▶</view>
      <view class="m2-promo-title">推广内容预留位</view>
      <view class="m2-promo-desc">
        后续可接视频、图片、活动宣传或二维码
      </view>
    </view>

    <button
      class="m2-primary-btn"
      bindtap="completePromo"
    >
      模拟完成观看
    </button>

  </view>

</view>

<!-- V1 生产订单卡模板 -->
<wxs module="noteFmt">
var SEP = ' · ';
function splitNote(note) {
  if (!note) return [];
  var parts = note.split(SEP);
  var out = [];
  for (var i = 0; i < parts.length; i++) {
    var s = parts[i];
    if (s && s.length > 0) out.push(s);
  }
  return out;
}
module.exports.splitNote = splitNote;
</wxs>

<template name="v1OrderCard">
  <view class="v1-order-card">
    <view class="v1-order-head">
      <text class="v1-order-time">{{item.dateLabel}} · {{item.timeLabel}}</text>
      <text class="v1-order-count">{{item.passengerCount}}人</text>
    </view>

    <view class="v1-route">
      <view class="v1-route-row">
        <view class="v1-route-dot v1-route-dot--start"></view>
        <text class="v1-route-name">{{item.fromName}}</text>
      </view>
      <view class="v1-route-connector"></view>
      <view class="v1-route-row">
        <view class="v1-route-dot v1-route-dot--end"></view>
        <text class="v1-route-name">{{item.toName}}</text>
      </view>
    </view>

    <view class="v1-order-foot {{item.note ? 'v1-order-foot--has-tags' : ''}}">
      <view class="v1-order-meta-col">
        <text class="v1-order-name">{{item.passengerName}}</text>
        <view class="v1-order-tags" wx:if="{{item.note}}">
          <view
            class="v1-order-tag"
            wx:for="{{noteFmt.splitNote(item.note)}}"
            wx:for-item="tag"
            wx:key="*this"
          >
            {{tag}}
          </view>
        </view>
      </view>
      <button
        class="v1-accept-btn"
        catchtap="onOpenAccept"
        data-id="{{item._id}}"
      >
        接单
      </button>
    </view>
  </view>
</template>

<view
  wx:if="{{!uiPrototypeMode}}"
  class="container tab-page v1-owner-page {{acceptModalVisible ? 'page-locked' : ''}}"
>

  <view class="v1-role-badge" wx:if="{{false}}">车主</view>

  <view class="v1-notice" wx:if="{{false}}">
    <view class="v1-notice-scroll">
      <view class="v1-notice-content {{noticeShouldScroll ? 'scrolling' : ''}}">
        <text class="v1-notice-label">今日迪闻：</text>
        <text class="v1-notice-text">{{noticeText}}</text>
      </view>
    </view>
  </view>

  <view class="v1-page-head v1-role-accent-bar--owner">
    <view class="v1-page-title v1-role-title--owner">顺路接单</view>
    <view class="v1-page-sub">筛选出发信息，匹配顺路订单</view>
  </view>

  <view class="v1-accepted-section" wx:if="{{hasOwnerIdentity && !isPassengerOnly && !loading && acceptedOrders.length}}">
    <view class="v1-section-title">已接单 · 待出发</view>
    <view
      class="v1-accepted-card"
      wx:for="{{acceptedOrders}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goAcceptedDetail"
    >
      <view class="v1-accepted-main">
        <view class="v1-order-time">{{item.dateLabel}} · {{item.timeLabel}}</view>
        <view class="v1-route v1-route--compact">
          <view class="v1-route-row">
            <view class="v1-route-dot v1-route-dot--start"></view>
            <text class="v1-route-name">{{item.fromName}}</text>
          </view>
          <view class="v1-route-connector"></view>
          <view class="v1-route-row">
            <view class="v1-route-dot v1-route-dot--end"></view>
            <text class="v1-route-name">{{item.toName}}</text>
          </view>
        </view>
      </view>
      <text class="v1-accepted-arrow">›</text>
    </view>
  </view>

  <view
    class="v1-section-divider"
    wx:if="{{hasOwnerIdentity && !isPassengerOnly && !loading && acceptedOrders.length}}"
  ></view>

  <view class="v1-filter-panel" wx:if="{{hasOwnerIdentity && !isPassengerOnly && !loading}}">
    <view class="v1-filter-head">
      <text class="v1-filter-title v1-role-title--owner">筛选</text>
      <text class="v1-filter-reset" wx:if="{{hasActiveFilters}}" bindtap="onResetFilters">清除</text>
    </view>
    <view class="v1-filter-sub">选择出发信息，匹配顺路订单</view>
    <view class="v1-filter-grid">
      <picker class="v1-filter-picker" mode="selector" range="{{filterDateLabels}}" value="{{filterDateIndex}}" bindchange="onFilterDateChange">
        <view class="v1-filter-chip">
          <text class="v1-filter-key">日期</text>
          <text class="v1-filter-val">{{filterDateLabels[filterDateIndex]}}</text>
        </view>
      </picker>
      <picker class="v1-filter-picker" mode="selector" range="{{filterTimeLabels}}" value="{{filterTimeIndex}}" bindchange="onFilterTimeChange">
        <view class="v1-filter-chip">
          <text class="v1-filter-key">时间</text>
          <text class="v1-filter-val">{{filterTimeLabels[filterTimeIndex]}}</text>
        </view>
      </picker>
      <view class="v1-filter-picker v1-filter-picker--search">
        <view class="v1-filter-search">
          <text class="v1-filter-key">出发</text>
          <input
            class="v1-filter-search-input"
            value="{{filterFromQuery}}"
            placeholder="请选择地点"
            confirm-type="search"
            bindinput="onFilterFromQueryInput"
            bindfocus="onFilterFromFocus"
            bindblur="onFilterFromBlur"
          />
        </view>
        <scroll-view
          scroll-y
          class="v1-filter-suggestions"
          wx:if="{{filterFromDropdownOpen}}"
          catchtouchmove="noop"
        >
          <view
            class="v1-filter-suggestion"
            wx:for="{{filterFromSuggestions}}"
            wx:key="pointId"
            data-id="{{item.pointId}}"
            catchtap="onSelectFilterFrom"
          >{{item.name}}</view>
        </scroll-view>
      </view>
      <view class="v1-filter-picker v1-filter-picker--search">
        <view class="v1-filter-search">
          <text class="v1-filter-key">到达</text>
          <input
            class="v1-filter-search-input"
            value="{{filterToQuery}}"
            placeholder="请选择地点"
            confirm-type="search"
            bindinput="onFilterToQueryInput"
            bindfocus="onFilterToFocus"
            bindblur="onFilterToBlur"
          />
        </view>
        <scroll-view
          scroll-y
          class="v1-filter-suggestions"
          wx:if="{{filterToDropdownOpen}}"
          catchtouchmove="noop"
        >
          <view
            class="v1-filter-suggestion"
            wx:for="{{filterToSuggestions}}"
            wx:key="pointId"
            data-id="{{item.pointId}}"
            catchtap="onSelectFilterTo"
          >{{item.name}}</view>
        </scroll-view>
      </view>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="v1-empty">加载中…</view>
  </block>

  <block wx:elif="{{isPassengerOnly}}">
    <view class="v1-empty">
      <view>当前为乘车人身份，无法接单</view>
      <button class="v1-btn-secondary v1-btn-secondary--ghost" bindtap="goAddOwnerIdentity">添加车主身份</button>
    </view>
  </block>

  <block wx:elif="{{!isPassengerOnly && !loading}}">
    <view class="v1-order-list">
      <block wx:if="{{allOrders.length}}">
        <view class="v1-pool-head">
          <view class="v1-pool-head-main">
            <view class="v1-section-title">订单池</view>
            <view class="v1-pool-hint" wx:if="{{!hasActiveFilters}}">看看有没有顺路的小伙伴</view>
          </view>
          <text class="v1-pool-count">{{allOrders.length}} 条待接</text>
        </view>

        <block wx:if="{{hasActiveFilters}}">
          <view class="v1-section-subtitle">筛选结果</view>
          <view class="v1-empty v1-empty--inline" wx:if="{{!matchedOrders.length}}">暂无完全符合条件的订单</view>
          <block wx:for="{{matchedOrders}}" wx:key="_id">
            <template is="v1OrderCard" data="{{item: item}}" />
          </block>

          <view class="v1-section-subtitle v1-section-subtitle--gap" wx:if="{{otherOrders.length}}">其他待接订单</view>
          <block wx:for="{{otherOrders}}" wx:key="_id">
            <template is="v1OrderCard" data="{{item: item}}" />
          </block>
        </block>

        <block wx:else>
          <block wx:for="{{matchedOrders}}" wx:key="_id">
            <template is="v1OrderCard" data="{{item: item}}" />
          </block>
        </block>
      </block>

      <view class="v1-empty v1-empty--compact" wx:elif="{{!acceptedOrders.length}}">
        <view>暂无匹配中订单</view>
      </view>

      <view class="v1-list-end" wx:if="{{acceptedOrders.length || allOrders.length}}">～已经到底啦～</view>
      <view class="list-bottom-spacer" wx:if="{{acceptedOrders.length || allOrders.length}}"></view>
    </view>
  </block>

  <view
  class="v1-accept-mask"
  wx:if="{{acceptModalVisible}}"
  bindtap="closeAcceptModal"
  catchtouchmove="noop"
>
  <view class="v1-accept-dialog" catchtap="noop">
    <view class="v1-accept-title">确认接单</view>
    <view class="v1-accept-desc">请确认以下订单信息</view>

    <view class="v1-accept-row">
      <text class="v1-accept-label">日期</text>
      <text class="v1-accept-value">{{acceptDateLabel}}</text>
    </view>
    <view class="v1-accept-row">
      <text class="v1-accept-label">时间</text>
      <text class="v1-accept-value">{{acceptTimeLabel}}</text>
    </view>
    <view class="v1-accept-row">
      <text class="v1-accept-label">路线</text>
      <text class="v1-accept-value">{{acceptModalOrder.routeLabel}}</text>
    </view>
    <view class="v1-accept-row">
      <text class="v1-accept-label">乘车人</text>
      <text class="v1-accept-value">{{acceptModalOrder.passengerName}}</text>
    </view>
    <view class="v1-accept-row">
      <text class="v1-accept-label">人数</text>
      <text class="v1-accept-value">{{acceptModalOrder.passengerCount}} 人</text>
    </view>
    <view class="v1-accept-row">
      <text class="v1-accept-label">备注</text>
      <text class="v1-accept-value">{{acceptModalOrder.note || '无'}}</text>
    </view>

    <view class="v1-accept-actions">
      <button class="v1-accept-action v1-accept-action--ghost" bindtap="closeAcceptModal" disabled="{{accepting}}">取消</button>
      <button class="v1-accept-action v1-accept-action--primary" bindtap="confirmAccept" loading="{{accepting}}" disabled="{{accepting}}">确认接单</button>
    </view>
  </view>
</view>

</view>