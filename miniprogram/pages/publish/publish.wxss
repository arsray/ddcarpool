/* ===== DDCarpool V1 — 乘客页 / 发布搭车单 ===== */

.v1-passenger-page.container.tab-page {
  padding: 16rpx 28rpx var(--space-md, 24rpx);
  background: #F5F7FA;
  box-sizing: border-box;
}

/* Role badge */
.v1-role-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: #EAF1FB;
  color: #003087;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

/* Page header */
.v1-page-head {
  margin-bottom: 16rpx;
}

.v1-page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.35;
}

.v1-page-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.4;
}

/* Form card */
.v1-form-card {
  padding: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-field-block {
  margin-bottom: 20rpx;
}

.v1-field {
  margin-bottom: 16rpx;
}

.v1-field--last-route {
  margin-bottom: 0;
}

.v1-field--last {
  margin-bottom: 0;
}

.v1-field-row {
  display: flex;
  gap: 12rpx;
}

.v1-field-col {
  flex: 1;
  min-width: 0;
}

.v1-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.3;
}

.v1-label--emph {
  font-size: 26rpx;
  font-weight: 500;
  color: #1F2937;
}

.v1-caption {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.4;
}

.v1-caption--above-tags {
  margin-top: 0;
  margin-bottom: 12rpx;
}

.v1-caption--pref {
  margin-top: 10rpx;
  margin-bottom: 0;
}

.v1-caption-link {
  color: #667085;
  text-decoration: underline;
}

/* Pickers */
.v1-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 16rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.v1-picker--route {
  height: 84rpx;
}

.v1-picker--disabled {
  color: #98A2B3;
}

.v1-picker-val {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-picker-placeholder {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 400;
  color: #98A2B3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.v1-picker-arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #98A2B3;
  line-height: 1;
}

/* Route block */
.v1-route-block {
  margin-bottom: 16rpx;
  padding-top: 4rpx;
}

.v1-poi-search {
  position: relative;
}

.v1-picker--input {
  padding-right: 12rpx;
}

.v1-poi-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
}

.v1-poi-suggestions {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 8rpx);
  z-index: 20;
  max-height: 360rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7ECF2;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(16, 24, 40, 0.08);
  box-sizing: border-box;
}

.v1-poi-suggestion {
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.v1-poi-suggestion:last-child {
  border-bottom: none;
}

.v1-poi-suggestion__name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
  line-height: 1.35;
}

.v1-poi-suggestion__hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #98A2B3;
  line-height: 1.35;
}

.v1-route-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.v1-route-dot--start {
  background: #22B573;
}

.v1-route-dot--end {
  background: #FF6B4A;
}

.v1-route-preview {
  margin: -4rpx 0 16rpx;
  padding: 12rpx 16rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #003087;
  line-height: 1.4;
}

/* Inline count picker */
.v1-label--inline {
  margin-bottom: 0;
  flex-shrink: 0;
}

.v1-inline-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  height: 80rpx;
  padding: 0 16rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.v1-inline-label-row .v1-label {
  margin-bottom: 0;
  flex-shrink: 0;
}

.v1-inline-picker {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.v1-inline-picker-val {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
}

/* Tags */
.v1-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.v1-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7ECF2;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
  box-sizing: border-box;
}

.v1-tag--on {
  background: #EAF1FB;
  border-color: #003087;
  color: #003087;
}

/* Textarea */
.v1-note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.v1-note-head .v1-label {
  margin-bottom: 0;
}

.v1-counter {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: #98A2B3;
}

.v1-textarea {
  display: block;
  width: 100%;
  height: 120rpx;
  min-height: 120rpx;
  max-height: 120rpx;
  padding: 12rpx 16rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #1F2937;
  line-height: 1.4;
  box-sizing: border-box;
}

/* Primary button */
.v1-btn-primary {
  margin: 0;
  background: #003087;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.v1-btn-primary::after {
  border: none;
}

.v1-submit-btn {
  width: 100%;
  height: 80rpx;
  margin-top: 24rpx;
  line-height: 80rpx;
  padding: 0;
}

/* Empty / loading */
.v1-empty {
  padding: 64rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.5;
}

.v1-empty-card {
  padding: 32rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.v1-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 10rpx;
}

.v1-empty-desc {
  font-size: 26rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.v1-empty-card .v1-btn-primary {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
}
