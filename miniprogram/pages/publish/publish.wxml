<page-meta page-style="{{dateDropdownOpen || timeDropdownOpen || fromDropdownOpen || toDropdownOpen || countDropdownOpen ? 'overflow:hidden;height:100%;' : ''}}" />

<view class="container tab-page v1-passenger-page">
  <block wx:if="{{loading}}">
    <view class="v1-empty">加载中…</view>
  </block>

  <block wx:elif="{{!hasPassengerIdentity}}">
    <view class="v1-role-badge" wx:if="{{false}}">乘客</view>
    <view class="v1-empty-card">
      <view class="v1-empty-title">需要乘车人身份</view>
      <view class="v1-empty-desc">搭车单由乘客发布，请先添加乘车人身份并设置偏好。</view>
      <button class="v1-btn-primary" bindtap="goAddPassengerIdentity">添加乘车人身份</button>
    </view>
    <view class="tab-bottom-spacer"></view>
  </block>

  <block wx:else>
    <view class="v1-role-badge" wx:if="{{false}}">乘客</view>

    <view class="v1-page-head v1-role-accent-bar--passenger">
      <view class="v1-page-title v1-role-title--passenger">{{pageTitle}}</view>
      <view class="v1-page-sub">{{pageSub}}</view>
    </view>

    <view class="v1-form-card">
      <view class="v1-field-block">
        <view class="v1-field-row">
          <view id="publish-field-date" class="v1-field-col v1-field-col--menu {{dateDropdownOpen ? 'v1-field-col--raised' : ''}}">
            <text class="v1-label">出发日期</text>
            <view class="v1-inline-menu">
              <view class="v1-picker" bindtap="onDateFieldTap">
                <text class="v1-picker-val">{{dateLabels[dateIndex]}}</text>
                <text class="v1-picker-arrow">›</text>
              </view>
            </view>
          </view>
          <view id="publish-field-time" class="v1-field-col v1-field-col--menu {{timeDropdownOpen ? 'v1-field-col--raised' : ''}}">
            <text class="v1-label">出发时间</text>
            <view class="v1-inline-menu">
              <view
                class="v1-picker"
                wx:if="{{hasAvailableSlots}}"
                bindtap="onTimeFieldTap"
              >
                <text class="v1-picker-val">{{form.timeWindow}}</text>
                <text class="v1-picker-arrow">›</text>
              </view>
              <view class="v1-picker v1-picker--disabled" wx:else>
                <text class="v1-picker-placeholder">当日可选时间窗已结束，请换日期</text>
              </view>
            </view>
          </view>
        </view>
        <text class="v1-caption">仅可选择今天起 7 日内</text>
      </view>

      <view class="v1-route-block">
        <view id="publish-field-from" class="v1-field {{fromDropdownOpen ? 'v1-field--raised' : ''}}">
          <text class="v1-label v1-label--emph">出发地点</text>
          <view class="v1-poi-search">
            <view class="v1-picker v1-picker--route v1-picker--input">
              <view class="v1-route-dot v1-route-dot--start"></view>
              <input
                class="v1-poi-input"
                value="{{fromQuery}}"
                placeholder="请输入或选择地点"
                confirm-type="search"
                adjust-position="{{false}}"
                cursor="{{fromCursor}}"
                bindinput="onFromQueryInput"
                bindfocus="onFromFocus"
                bindblur="onFromBlur"
              />
            </view>
          </view>
        </view>

        <view id="publish-field-to" class="v1-field v1-field--last-route {{toDropdownOpen ? 'v1-field--raised' : ''}}">
          <text class="v1-label v1-label--emph">目的地</text>
          <view class="v1-poi-search">
            <view class="v1-picker v1-picker--route v1-picker--input">
              <view class="v1-route-dot v1-route-dot--end"></view>
              <input
                class="v1-poi-input"
                value="{{toQuery}}"
                placeholder="请输入或选择地点"
                confirm-type="search"
                adjust-position="{{false}}"
                cursor="{{toCursor}}"
                bindinput="onToQueryInput"
                bindfocus="onToFocus"
                bindblur="onToBlur"
              />
            </view>
          </view>
        </view>
        <text class="v1-caption">支持点位名称、别名或拼音首字母，如 603 / PAB / mq</text>
      </view>

      <view class="v1-route-preview" wx:if="{{routePreview}}">{{routePreview}}</view>

      <view id="publish-field-count" class="v1-field {{countDropdownOpen ? 'v1-field--raised' : ''}}">
        <text class="v1-label">出行人数</text>
        <view class="v1-inline-menu">
          <view class="v1-picker" bindtap="onCountFieldTap">
            <text class="v1-picker-val">{{form.passengerCount}}人</text>
            <text class="v1-picker-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="v1-field">
        <text class="v1-label">特殊要求</text>
        <text class="v1-caption v1-caption--above-tags">选择适合你的标签</text>
        <view class="v1-tags">
          <view
            wx:for="{{noteTags}}"
            wx:key="*this"
            class="v1-tag {{selectedNoteMap[item] ? 'v1-tag--on' : ''}}"
            data-tag="{{item}}"
            bindtap="toggleNoteTag"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view class="v1-field v1-field--last">
        <view class="v1-note-head">
          <text class="v1-label">自定义要求</text>
          <text class="v1-counter">{{noteLength}}/{{maxNoteLength}}</text>
        </view>
        <textarea
          class="v1-textarea"
          auto-height="{{false}}"
          value="{{form.note}}"
          bindinput="onNoteInput"
          placeholder="可自由填写其他要求"
          maxlength="{{maxNoteLength}}"
        />
        <text class="v1-caption v1-caption--pref">可在「<text class="v1-caption-link" bindtap="goPreference">乘车偏好</text>」中预设常用标签</text>
      </view>

      <button
        class="v1-btn-primary v1-submit-btn"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="onSubmit"
      >
        {{submitLabel}}
      </button>
    </view>

    <view
      wx:if="{{dateDropdownOpen || timeDropdownOpen || fromDropdownOpen || toDropdownOpen || countDropdownOpen}}"
      class="v1-filter-float-mask"
      catchtap="closeAllDropdowns"
    />
    <view
      wx:if="{{(dateDropdownOpen || timeDropdownOpen || fromDropdownOpen || toDropdownOpen || countDropdownOpen) && publishFloatItems.length}}"
      class="v1-filter-float-menu"
      style="top: {{publishFloatTop}}px; left: {{publishFloatLeft}}px; width: {{publishFloatWidth}}px;"
      catchtap="noop"
    >
      <scroll-view
        scroll-y
        enable-flex
        class="v1-filter-float-scroll"
        style="height: {{inlineMenuHeightPx}}px;"
        bindtouchstart="onPublishFloatTouchStart"
        bindtouchend="onPublishFloatTouchEnd"
        bindscroll="onPublishFloatScroll"
      >
        <view
          class="v1-poi-suggestion"
          wx:for="{{publishFloatItems}}"
          wx:key="key"
          data-index="{{item.index}}"
          data-id="{{item.pointId}}"
          bindtap="onPublishFloatPick"
        >
          <text class="v1-poi-suggestion__name">{{item.label}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="tab-bottom-spacer"></view>
  </block>
</view>
