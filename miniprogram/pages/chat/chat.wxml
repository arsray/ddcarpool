<view class="container">
  <view class="scaffold-banner">协作脚手架 · {{module}}</view>
  <view class="card">
    <view class="scaffold-title">{{pageName}}</view>
    <view class="scaffold-desc">模块负责人：{{owner}}</view>
    <view class="scaffold-desc">待实现：{{todo}}</view>
