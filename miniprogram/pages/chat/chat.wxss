.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f0f4f8;
}

.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.chat-loading,
.chat-empty,
.chat-loading-more {
  padding: 80rpx 24rpx;
  color: #667085;
  text-align: center;
}

.chat-loading-more {
  padding: 16rpx 24rpx;
  font-size: 22rpx;
}

.chat-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.chat-row--mine {
  align-items: flex-end;
}

.chat-meta {
  margin: 0 12rpx 8rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.chat-bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  color: #172b4d;
  font-size: 28rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.chat-row--mine .chat-bubble {
  background: #003087;
  color: #ffffff;
}

.chat-spacer {
  height: 32rpx;
}

.chat-compose {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e4e7ec;
}

.chat-input {
  flex: 1;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #f2f4f7;
}

.chat-send {
  margin: 0;
  color: #ffffff;
  background: #003087;
  border-radius: 32rpx;
}
