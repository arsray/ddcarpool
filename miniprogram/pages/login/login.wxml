<view class="v1-login-page">
  <view class="v1-brand">
    <view class="v1-brand-en">DDCarpool</view>
    <view class="v1-brand-zh">迪迪蹭车</view>
    <view class="v1-brand-sub">和同事顺路同行</view>
  </view>

  <view class="v1-form-card">
    <view class="v1-field">
      <text class="v1-label">Disney Email</text>
      <view class="v1-email-row {{emailError ? 'is-error' : ''}}">
        <input
          class="v1-email-prefix"
          type="text"
          placeholder="firstname.lastname"
          value="{{emailPrefix}}"
          bindinput="onEmailPrefixInput"
          bindblur="onEmailBlur"
        />
        <text class="v1-email-suffix">@disney.com</text>
      </view>
      <text class="v1-error" wx:if="{{emailError}}">{{emailError}}</text>
    </view>

    <view class="v1-field">
      <text class="v1-label">验证码</text>
      <view class="v1-code-row">
        <input
          class="v1-input v1-code-input {{codeError ? 'is-error' : ''}}"
          type="number"
          maxlength="6"
          placeholder="6 位验证码"
          value="{{code}}"
          bindinput="onCodeInput"
        />
        <button
          class="v1-code-btn {{canSendCode && !sendingCode ? '' : 'is-disabled'}}"
          size="mini"
          disabled="{{!canSendCode || sendingCode}}"
          bindtap="sendCode"
        >{{sendText}}</button>
      </view>
      <text class="v1-error" wx:if="{{codeError}}">{{codeError}}</text>
    </view>

    <view class="v1-agreement-row">
      <view class="v1-agreement-check {{agreedToTerms ? 'is-checked' : ''}}" bindtap="toggleAgreement">
        <text wx:if="{{agreedToTerms}}" class="v1-agreement-check-icon">✓</text>
      </view>
      <view class="v1-agreement-text">
        <text bindtap="toggleAgreement">我已阅读并同意</text>
        <text class="v1-agreement-link" catchtap="viewAgreement">《用户服务协议》</text>
      </view>
    </view>

    <button
      class="v1-login-btn {{canSubmit ? '' : 'is-disabled'}}"
      disabled="{{!canSubmit}}"
      bindtap="onLogin"
    >注册或登录</button>
  </view>

  <view class="v1-hint" wx:if="{{previewCode}}">预览模式：验证码 {{previewCode}}（正式版将发至邮箱）</view>
</view>
