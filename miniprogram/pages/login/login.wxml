<view class="login-page">
  <view class="login-card">
    <view class="login-title">Cast 顺风车</view>
    <view class="login-sub">Cast Member 内部顺风车</view>

    <view class="field">
      <text class="label">公司邮箱</text>
      <view class="email-row {{emailError ? 'email-row-error' : ''}}">
        <input
          class="email-prefix"
          type="text"
          placeholder="firstname.lastname"
          value="{{emailPrefix}}"
          bindinput="onEmailPrefixInput"
          bindblur="onEmailBlur"
        />
        <text class="email-suffix">@disney.com</text>
      </view>
      <text class="error-text" wx:if="{{emailError}}">{{emailError}}</text>
    </view>

    <view class="field">
      <text class="label">验证码</text>
      <view class="code-row">
        <input
          class="input code-input {{codeError ? 'input-error' : ''}}"
          type="number"
          maxlength="6"
          placeholder="6 位验证码"
          value="{{code}}"
          bindinput="onCodeInput"
        />
        <button
          class="code-btn {{canSendCode ? '' : 'code-btn-disabled'}}"
          size="mini"
          disabled="{{!canSendCode}}"
          bindtap="sendCode"
        >{{sendText}}</button>
      </view>
      <text class="error-text" wx:if="{{codeError}}">{{codeError}}</text>
    </view>

    <button
      class="btn-primary login-btn {{canSubmit ? '' : 'login-btn-disabled'}}"
      disabled="{{!canSubmit}}"
      bindtap="onLogin"
    >注册或登录</button>

    <view class="hint" wx:if="{{previewCode}}">预览模式：验证码 {{previewCode}}（正式版将发至邮箱）</view>
  </view>
</view>
