@import '../mine/m1-shared.wxss';

.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: linear-gradient(160deg, #1e3a8a, #4f46e5);
}

.login-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
}

.login-sub {
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
  margin: 12rpx 0 40rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.input {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.email-row {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  min-height: 88rpx;
}

.email-row-error {
  border-color: #ef4444;
  background: #fef2f2;
}

.email-prefix {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  padding: 20rpx 0;
}

.email-suffix {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #64748b;
}

.input-error {
  border-color: #ef4444;
  background: #fef2f2;
}

.error-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ef4444;
}

.code-row {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  background: #eff6ff;
  color: #2563eb;
  min-width: 180rpx;
}

.code-btn-disabled {
  background: #f1f5f9 !important;
  color: #94a3b8 !important;
}

.login-btn {
  margin-top: 16rpx;
}

.login-btn-disabled {
  opacity: 0.5;
}

.hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.6;
}
