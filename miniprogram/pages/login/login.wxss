/* ===== DDCarpool V1 — 登录 ===== */

.v1-login-page {
  min-height: 100vh;
  padding: 48rpx 36rpx 80rpx;
  background: #F5F7FA;
  box-sizing: border-box;
}

/* Brand */
.v1-brand {
  margin-bottom: 32rpx;
}

.v1-brand-en {
  font-size: 22rpx;
  font-weight: 600;
  color: #003087;
  line-height: 1.4;
  letter-spacing: 0.04em;
}

.v1-brand-zh {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.25;
}

.v1-brand-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
}

/* Form card */
.v1-form-card {
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDF0F4;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-field {
  margin-bottom: 24rpx;
}

.v1-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
}

.v1-email-row,
.v1-input {
  height: 80rpx;
  background: #F8FAFC;
  border: 1rpx solid #E7ECF2;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.v1-email-row {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.v1-email-prefix {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 80rpx;
}

.v1-email-suffix {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.3;
}

.v1-input {
  width: 100%;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 80rpx;
}

.v1-email-row:focus-within,
.v1-input:focus {
  border-color: #C5D4EB;
}

.v1-email-row.is-error,
.v1-input.is-error {
  border-color: #E8B4B0;
  background: #FDF7F6;
}

.v1-error {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #C4473A;
  line-height: 1.4;
}

.v1-code-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.v1-code-input {
  flex: 1;
  min-width: 0;
}

.v1-code-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 8rpx;
  min-width: 0;
  height: 80rpx;
  line-height: 80rpx;
  background: transparent;
  color: #003087;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.v1-code-btn::after {
  border: none;
}

.v1-code-btn.is-disabled {
  color: #98A2B3 !important;
  background: transparent !important;
}

.v1-login-btn {
  display: block;
  width: 100%;
  height: 80rpx;
  margin: 8rpx 0 0;
  padding: 0;
  line-height: 80rpx;
  background: #003087;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.v1-login-btn::after {
  border: none;
}

.v1-login-btn.is-disabled {
  opacity: 0.45;
}

.v1-hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #98A2B3;
  text-align: center;
  line-height: 1.6;
}
