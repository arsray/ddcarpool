<view class="v1-onboard-page container">
  <view class="v1-brand">DDCarpool</view>
  <view class="v1-head">
    <view class="v1-title">{{pageTitle}}</view>
    <view class="v1-sub">{{pageSub}}</view>
  </view>

  <view
    class="v1-role-card {{selected === 'owner' ? 'on owner' : ''}}"
    data-role="owner"
    bindtap="onSelect"
  >
    <view class="v1-role-mark v1-role-mark--owner"></view>
    <view class="v1-role-main">
      <view class="v1-role-name">我是车主</view>
      <view class="v1-role-desc">发布发车单，顺路带同事</view>
    </view>
    <view class="v1-check" wx:if="{{selected === 'owner'}}">✓</view>
  </view>

  <view
    class="v1-role-card {{selected === 'passenger' ? 'on passenger' : ''}}"
    data-role="passenger"
    bindtap="onSelect"
  >
    <view class="v1-role-mark v1-role-mark--passenger"></view>
    <view class="v1-role-main">
      <view class="v1-role-name">我是乘车人</view>
      <view class="v1-role-desc">发布搭车单，寻找顺路车主</view>
    </view>
    <view class="v1-check" wx:if="{{selected === 'passenger'}}">✓</view>
  </view>

  <view class="v1-tip">首次请选择一个身份；另一种身份可在「我的」中后续添加</view>

  <button class="v1-cta" disabled="{{!selected}}" bindtap="onNext">下一步</button>
</view>
