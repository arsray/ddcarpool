/* ===== DDCarpool V1 — 身份选择 / Onboarding ===== */

.v1-onboard-page.container {
  padding: 24rpx 32rpx 48rpx;
  background: #F5F7FA;
  box-sizing: border-box;
}

.v1-brand {
  margin-bottom: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #003087;
  letter-spacing: 0.04em;
  line-height: 1.4;
}

.v1-head {
  margin-bottom: 28rpx;
}

.v1-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.3;
}

.v1-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.45;
}

.v1-role-card {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7ECF2;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.v1-role-card.on,
.v1-role-card.on.owner,
.v1-role-card.on.passenger {
  background: #EAF1FB;
  border-color: #003087;
}

.v1-role-card:active {
  opacity: 0.92;
}

.v1-role-mark {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin-right: 16rpx;
  border-radius: 50%;
}

.v1-role-mark--owner {
  background: #22B573;
}

.v1-role-mark--passenger {
  background: #FF6B4A;
}

.v1-role-main {
  flex: 1;
  min-width: 0;
}

.v1-role-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.35;
}

.v1-role-card.on .v1-role-name {
  color: #003087;
}

.v1-role-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #667085;
  line-height: 1.4;
}

.v1-check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #003087;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: center;
}

.v1-tip {
  margin: 8rpx 0 32rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #98A2B3;
  line-height: 1.55;
}

.v1-cta {
  display: block;
  width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0;
  line-height: 80rpx;
  background: #003087;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.v1-cta::after {
  border: none;
}

.v1-cta[disabled] {
  opacity: 0.4;
  color: #FFFFFF;
}
