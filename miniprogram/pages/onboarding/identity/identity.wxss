@import '../../mine/m1-shared.wxss';

.head {
  margin-bottom: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.option-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.option-card.on.owner {
  border-color: #93c5fd;
  background: #eff6ff;
}

.option-card.on.passenger {
  border-color: #6ee7b7;
  background: #ecfdf5;
}

.option-icon {
  font-size: 48rpx;
}

.option-main {
  flex: 1;
}

.option-title {
  font-size: 30rpx;
  font-weight: 600;
}

.option-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #4f46e5;
  color: #fff;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
}

.tip {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
  margin: 24rpx 0 32rpx;
}

.next-btn {
  width: 100%;
}
