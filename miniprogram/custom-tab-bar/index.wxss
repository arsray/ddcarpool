.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #EDF0F4;
  box-sizing: border-box;
}

.tab-bar-inner {
  display: flex;
  align-items: stretch;
  height: 96rpx;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 8rpx 0 6rpx;
  color: #98A2B3;
  box-sizing: border-box;
}

.tab-bar-item.active {
  color: #003087;
}

.tab-icon {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
  flex-shrink: 0;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 400;
}

.tab-bar-item.active .tab-text {
  font-weight: 500;
}

/* Owner — car */
.icon-car-body {
  position: absolute;
  top: 12rpx;
  left: 4rpx;
  width: 32rpx;
  height: 16rpx;
  border: 2rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.icon-car-wheel {
  position: absolute;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-car-wheel-l {
  left: 10rpx;
}

.icon-car-wheel-r {
  right: 10rpx;
}

/* Passenger — person */
.icon-person-head {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-left: -6rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-person-body {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  width: 22rpx;
  height: 12rpx;
  margin-left: -11rpx;
  border: 2rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
}

/* Message — chat bubble */
.icon-bubble {
  position: absolute;
  top: 6rpx;
  left: 4rpx;
  width: 30rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.icon-bubble-tail {
  position: absolute;
  bottom: 8rpx;
  left: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-left: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(-45deg);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
}

.tab-bar-item.active .icon-bubble-tail {
  background: rgba(255, 255, 255, 0.96);
}

.tab-badge {
  position: absolute;
  top: -2rpx;
  right: -10rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #E53935;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tab-badge-text {
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 600;
}

/* Mine — profile */
.icon-profile-head {
  position: absolute;
  top: 5rpx;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-profile-body {
  position: absolute;
  bottom: 3rpx;
  left: 50%;
  width: 24rpx;
  height: 13rpx;
  margin-left: -12rpx;
  border: 2rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
  box-sizing: border-box;
}
