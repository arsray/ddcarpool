.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: stretch;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  box-shadow: 0 -4rpx 20rpx rgba(0, 48, 135, 0.06);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a94a6;
}

.tab-bar-item.active {
  color: #003087;
}

.tab-icon {
  font-size: 34rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1.2;
}
