.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #EDF0F4;
  box-sizing: border-box;
}

.tab-bar-inner {
  display: flex;
  align-items: stretch;
  height: 96rpx;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 8rpx 0 6rpx;
  color: #98A2B3;
  box-sizing: border-box;
}

.tab-bar-item.active {
  color: #003087;
}

.tab-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}

.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-bar-item:not(.active) .tab-icon-img {
  opacity: 0.42;
}

.tab-bar-item.active .tab-icon-img {
  opacity: 1;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 400;
}

.tab-bar-item.active .tab-text {
  font-weight: 500;
}

.tab-badge {
  position: absolute;
  top: -4rpx;
  right: -12rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #E53935;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tab-badge-text {
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 600;
}
