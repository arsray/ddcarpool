<view class="tab-bar">
  <view class="tab-bar-inner">
    <view
      wx:for="{{list}}"
      wx:key="key"
      class="tab-bar-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon">
        <image
          class="tab-icon-img"
          src="{{item.iconSrc}}"
          mode="aspectFit"
          aria-hidden="true"
        />
        <view wx:if="{{item.key === 'notify' && unreadCount > 0}}" class="tab-badge">
          <text class="tab-badge-text">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
        </view>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
